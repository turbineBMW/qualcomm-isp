+/* Rear RAW quads estimate the pre-gamma CCM highlight envelope. This does
+ * not reconstruct the hardware demosaic or replace the sensor/WB ceiling.
+ * Retain joint samples: independent channel histograms lose color covariance.
+ */
+class CamssCcmStats
+{
+public:
+	struct Sample {
+		std::array<uint16_t, 4> value; /* shaded R, Gr, Gb, B, black64 */
+		bool centre;
+	};
+	using Samples = std::vector<Sample>;
+	struct Peak {
+		bool valid = false;
+		double value = 0;
+		double saturated = 0;
+	};
+
+	bool configure(const std::array<int32_t, 12> &matrix)
+	{
+		enabled_ = false;
+		/* Offsets change exposure scaling and need a separate model. */
+		for (unsigned int i = 9; i < 12; i++)
+			if (matrix[i])
+				return false;
+		int32_t maximum = 0;
+		for (unsigned int i = 0; i < 9; i++) {
+			if (matrix[i] < -8192 || matrix[i] > 8191)
+				return false;
+			maximum = std::max(maximum, std::abs(matrix[i]));
+		}
+		for (unsigned int row = 0; row < 3; row++) {
+			int32_t sum = matrix[row * 3] + matrix[row * 3 + 1] + matrix[row * 3 + 2];
+			if (std::abs(sum - 1024) > 32 || matrix[row * 4] < 512)
+				return false;
+		}
+		/* Match vfe_680_pix_set_cc: signed division truncates toward zero
+		 * when coefficients exceed the hardware's signed twelve-bit range. */
+		unsigned int shift = 0;
+		while (maximum > 2047) {
+			maximum >>= 1;
+			shift++;
+		}
+		for (unsigned int i = 0; i < 9; i++)
+			matrix_[i] = (matrix[i] / (1 << shift)) / double(1024 >> shift);
+		enabled_ = true;
+		return true;
+	}
+
+	bool enabled() const { return enabled_; }
+
+	Peak evaluate(const Samples &samples, unsigned int expected,
+		      const std::array<double, 2> &wb, double percentile, bool centre) const
+	{
+		if (!enabled_ || !expected || !std::isfinite(percentile) || percentile <= 0 || percentile > 1)
+			return {};
+		for (double gain : wb)
+			if (!std::isfinite(gain) || gain < 0.25 || gain > 4)
+				return {};
+		/* Overflow is retained at 8x full scale; enough to force the
+		 * bounded AE step down, without unbounded histogram allocation. */
+		std::array<unsigned int, 8193> histogram{};
+		unsigned int count = 0, saturated = 0;
+		for (const auto &sample : samples) {
+			if (centre && !sample.centre)
+				continue;
+			std::array<double, 4> raw{};
+			for (unsigned int i = 0; i < 4; i++) {
+				if (sample.value[i] > 1023)
+					return {};
+				raw[i] = std::max(int(sample.value[i]) - 64, 0) / 1024.0;
+			}
+			/* WB precedes demosaic/CCM. Keep the original RAW/WB ceiling
+			 * separately, since clipped inputs can hide later amplification. */
+			std::array<double, 3> rgb = {
+				std::min(raw[0] * wb[0], 4095.0 / 4096),
+				(raw[1] + raw[2]) / 2,
+				std::min(raw[3] * wb[1], 4095.0 / 4096)
+			};
+			double peak = 0;
+			for (unsigned int row = 0; row < 3; row++) {
+				double value = 0;
+				for (unsigned int col = 0; col < 3; col++)
+					value += matrix_[row * 3 + col] * rgb[col];
+				peak = std::max(peak, value);
+			}
+			unsigned int code = std::min(8192u, static_cast<unsigned int>(std::ceil(peak * 1024)));
+			histogram[code]++;
+			saturated += peak >= 1020.0 / 1024;
+			count++;
+		}
+		if (count != expected)
+			return {};
+		unsigned int accumulated = 0;
+		unsigned int threshold = std::ceil(expected * percentile);
+		for (unsigned int code = 0; code < histogram.size(); code++) {
+			accumulated += histogram[code];
+			if (accumulated >= threshold)
+				return { true, code / 1024.0, saturated / double(count) };
+		}
+		return {};
+	}
+
+private:
+	bool enabled_ = false;
+	std::array<double, 9> matrix_{};
+};
+
+} /* namespace libcamera */
