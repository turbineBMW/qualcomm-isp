@@ -0,0 +1,71 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstdint>
+#include <vector>
+
+namespace libcamera {
+
+/* Qualified rear geometry only. Mirror a small, neutral, linear hardware
+ * shading mesh for the control algorithms; saved RAW remains unmodified.
+ * Separate color meshes and nonlinear gain response need their own model.
+ */
+class CamssLscStats
+{
+public:
+	bool configure(const std::vector<uint16_t> &mesh)
+	{
+		enabled_ = false;
+		if (mesh.size() != 4 * 221)
+			return false;
+		if (std::all_of(mesh.begin(), mesh.end(), [](auto v) { return v == 0; }))
+			return true;
+		for (unsigned int i = 0; i < mesh.size(); i++)
+			if (mesh[i] < 1024 || mesh[i] > 1280 || mesh[i] != mesh[i % 221])
+				return false;
+		for (unsigned int y = 0; y < 135; y++) {
+			unsigned int rawY = (((y * 16 + 344) * 3136 / 2850) & ~1u);
+			for (unsigned int x = 0; x < 240; x++) {
+				unsigned int rawX = ((x * 16 * 4224 / 3840) & ~1u);
+				gains_[y * 240 + x] = std::lround(sample(mesh, rawX / 2.0 / 2111 * 16,
+								      rawY / 2.0 / 1567 * 12));
+			}
+		}
+		enabled_ = true;
+		return true;
+	}
+
+	bool enabled() const { return enabled_; }
+
+	std::array<unsigned int, 4> apply(std::array<unsigned int, 4> quad,
+					unsigned int x, unsigned int y) const
+	{
+		if (!enabled_)
+			return quad;
+		unsigned int gain = gains_.at((y / 16) * 240 + x / 16);
+		for (auto &v : quad) {
+			/* Preserve the sensor pedestal and model saturation before WB. */
+			if (v > 64)
+				v = std::min(1023u, 64 + ((v - 64) * gain + 512) / 1024);
+		}
+		return quad;
+	}
+
+private:
+	static double sample(const std::vector<uint16_t> &mesh, double x, double y)
+	{
+		unsigned int ix = std::min(15u, static_cast<unsigned int>(x));
+		unsigned int iy = std::min(11u, static_cast<unsigned int>(y));
+		double fx = x - ix, fy = y - iy;
+		return (1 - fy) * ((1 - fx) * mesh[iy * 17 + ix] + fx * mesh[iy * 17 + ix + 1]) +
+			fy * ((1 - fx) * mesh[(iy + 1) * 17 + ix] + fx * mesh[(iy + 1) * 17 + ix + 1]);
+	}
+
+	bool enabled_ = false;
+	std::array<uint16_t, 32400> gains_{};
+};
+
+} /* namespace libcamera */
