From 61d4d23ba8358d5511b784835742721c182945e3 Mon Sep 17 00:00:00 2001
From: Brandon Williams <turbine.bmw@gmail.com>
Date: Tue, 13 Oct 2026 19:34:32 -0400
Subject: [PATCH 2323/2368] arm64: dts: qcom: hamoa: add CSI2 PHY nodes

Describe CSIPHY0, 1, 2 and 4 as qcom,x1e80100-csi2-phy nodes with their
core, timer and AHB clocks, interrupt, Titan top GDSC plus the MMCX and
MXC rails, and a shared OPP table that scales both rails with the PHY
core clock. The nodes stay disabled; a board enables the PHYs it wires,
supplies their analog rails and connects a sensor to port 0 and the
camss CSID to port 1.

The register windows are 8 KiB for the first three PHYs and 16 KiB for
CSIPHY4: the 3-phase common control block starts 4 KiB into each window.

Signed-off-by: Brandon Williams <turbine.bmw@gmail.com>
(cherry picked from commit 0e998ad5ec6e71ddef15f06111682c38bfc6bb41)

diff --git a/arch/arm64/boot/dts/qcom/hamoa.dtsi b/arch/arm64/boot/dts/qcom/hamoa.dtsi
index 2e72fa81e807d1dab48ca4f28a0a2b4ad8049b7d..e1bc31eb96b74f95f84b10304c39916a6940c8d3 100644
--- a/arch/arm64/boot/dts/qcom/hamoa.dtsi
+++ b/arch/arm64/boot/dts/qcom/hamoa.dtsi
@@ -368,6 +368,28 @@ memory@80000000 {
 		reg = <0 0x80000000 0 0>;
 	};
 
+	csiphy_opp_table: opp-table-csiphy {
+		compatible = "operating-points-v2";
+
+		opp-300000000 {
+			opp-hz = /bits/ 64 <300000000>;
+			required-opps = <&rpmhpd_opp_low_svs>,
+					<&rpmhpd_opp_low_svs>;
+		};
+
+		opp-400000000 {
+			opp-hz = /bits/ 64 <400000000>;
+			required-opps = <&rpmhpd_opp_svs>,
+					<&rpmhpd_opp_svs>;
+		};
+
+		opp-480000000 {
+			opp-hz = /bits/ 64 <480000000>;
+			required-opps = <&rpmhpd_opp_nom>,
+					<&rpmhpd_opp_nom>;
+		};
+	};
+
 	pmu {
 		compatible = "arm,armv8-pmuv3";
 		interrupts = <GIC_PPI 7 IRQ_TYPE_LEVEL_LOW>;
@@ -5633,6 +5655,158 @@ cci1_i2c1: i2c-bus@1 {
 			};
 		};
 
+		csiphy0: phy@ace4000 {
+			compatible = "qcom,x1e80100-csi2-phy";
+			reg = <0 0x0ace4000 0 0x2000>;
+
+			clocks = <&camcc CAM_CC_CSIPHY0_CLK>,
+				 <&camcc CAM_CC_CSI0PHYTIMER_CLK>,
+				 <&camcc CAM_CC_CORE_AHB_CLK>;
+			clock-names = "core",
+				      "timer",
+				      "ahb";
