+/*
+ * The sensor's array timing clock includes blanking and can exceed the
+ * receiver's pixel throughput. Bound C-PHY traffic by its link capacity:
+ * link_freq is half the symbol rate, with 16 bits per 7 symbols per trio.
+ * Keep the existing timing-clock fallback when no link rate is available.
+ */
+static int vfe_get_pixel_clock(struct vfe_line *line, u64 *pixel_clock)
+{
+	struct media_entity *entity = &line->subdev.entity;
+	struct media_pad *pad;
+	struct v4l2_subdev *sensor;
+	struct csiphy_device *csiphy;
+	s64 link_freq;
+	u64 link_pixel_rate;
+	u8 bpp;
+	int ret;
+
+	ret = camss_get_pixel_clock(entity, pixel_clock);
+	if (ret)
+		return ret;
+
+	pad = camss_find_sensor_pad(entity);
+	if (!pad)
+		return 0;
+	sensor = media_entity_to_v4l2_subdev(pad->entity);
+	csiphy = sensor->host_priv;
+	if (!csiphy || !csiphy->cfg.csi2 || !csiphy->cfg.csi2->is_cphy)
+		return 0;
+
+	bpp = camss_format_get_bpp(line->formats, line->nformats,
+				   line->fmt[MSM_VFE_PAD_SINK].code);
+	if (!bpp || csiphy->cfg.csi2->lane_cfg.num_data <= 0)
+		return 0;
+	/* Do not estimate a link rate from the timing clock we are bounding. */
+	link_freq = v4l2_get_link_freq(pad, 0, 0);
+	if (link_freq <= 0)
+		return 0;
+
+	link_pixel_rate = div_u64(link_freq * 32ULL *
+				 csiphy->cfg.csi2->lane_cfg.num_data, 7 * bpp);
+	*pixel_clock = min(*pixel_clock, link_pixel_rate);
+	return 0;
+}
