-		ret = camss_get_pixel_clock(&vfe->line[i].subdev.entity,
-					    &pixel_clock[i]);
+		ret = vfe_get_pixel_clock(&vfe->line[i], &pixel_clock[i]);
 		if (ret)
 			pixel_clock[i] = 0;
 	}
@@ -1114,8 +1166,7 @@ static int vfe_check_clock_rates(struct vfe_device *vfe)
 	int ret;
 
 	for (i = VFE_LINE_RDI0; i < vfe->res->line_num; i++) {
