diff --git a/drivers/media/platform/qcom/camss/camss-video.c b/drivers/media/platform/qcom/camss/camss-video.c
index 3e9250f8e9712df577d0f5cb85a989404028dd89..0d23b0d191b9b3dd90ebb8a2b62231ac69d1ff83 100644
--- a/drivers/media/platform/qcom/camss/camss-video.c
+++ b/drivers/media/platform/qcom/camss/camss-video.c
@@ -249,6 +249,54 @@ static int video_prepare_streaming(struct vb2_queue *q)
 	return ret;
 }
 
+struct camss_stream_user {
+	struct list_head list;
+	struct v4l2_subdev *subdev;
+	unsigned int count;
+};
+
+/* Start a shared sensor/receiver once and stop it after its last output. */
+static int video_set_stream(struct camss *camss, struct v4l2_subdev *subdev,
+			    bool enable)
+{
+	struct camss_stream_user *user;
+	int ret = 0;
+
+	mutex_lock(&camss->stream_lock);
+	list_for_each_entry(user, &camss->stream_users, list) {
+		if (user->subdev != subdev)
+			continue;
+		if (enable) {
+			user->count++;
+		} else if (!--user->count) {
+			ret = v4l2_subdev_call(subdev, video, s_stream, 0);
+			list_del(&user->list);
+			kfree(user);
+		}
+		goto unlock;
+	}
+	if (!enable) {
+		ret = -EINVAL;
+		goto unlock;
+	}
+	user = kzalloc(sizeof(*user), GFP_KERNEL);
+	if (!user) {
+		ret = -ENOMEM;
+		goto unlock;
+	}
+	ret = v4l2_subdev_call(subdev, video, s_stream, 1);
+	if (ret < 0 && ret != -ENOIOCTLCMD) {
+		kfree(user);
+		goto unlock;
+	}
+	user->subdev = subdev;
+	user->count = 1;
+	list_add(&user->list, &camss->stream_users);
+unlock:
+	mutex_unlock(&camss->stream_lock);
+	return ret;
+}
+
 static void video_stop_subdevices(struct camss_video *video,
 				  const struct media_entity *stop_entity)
 {
