index 534b3c810fa8a2e6d5766c5168bfb1abd4e7781f..6fd46f85e7e8bd006504b100103edaa7a9e6d324 100644
--- a/Documentation/devicetree/bindings/media/qcom,x1e80100-camss.yaml
