From 5f0c9138e3814ef7693a99da48f229a6709765cd Mon Sep 17 00:00:00 2001
From: Dale Whinham <daleyo@gmail.com>
Date: Mon, 12 May 2025 18:37:13 +0000
Subject: [PATCH 2125/2165] wifi: ath12k: Add support for disabling rfkill via
 devicetree

Signed-off-by: Dale Whinham <daleyo@gmail.com>
(cherry picked from commit 5ec3ede36091198a39c0c7a82a32152eb961e64d)

diff --git a/drivers/net/wireless/ath/ath12k/core.c b/drivers/net/wireless/ath/ath12k/core.c
index 5cdf4973d986afd3937ed41a5a246e10fcefcffd..6230d54d8be9596eba353dbcd98a89cf4eed56bf 100644
--- a/drivers/net/wireless/ath/ath12k/core.c
+++ b/drivers/net/wireless/ath/ath12k/core.c
@@ -80,6 +80,9 @@ static int ath12k_core_rfkill_config(struct ath12k_base *ab)
 	if (ath12k_acpi_get_disable_rfkill(ab))
 		return 0;
 
+	if (of_property_read_bool(ab->dev->of_node, "disable-rfkill"))
+		return 0;
+
 	for (i = 0; i < ab->num_radios; i++) {
 		ar = ab->pdevs[i].ar;
 
