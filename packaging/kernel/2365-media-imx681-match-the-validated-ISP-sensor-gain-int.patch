From c7a9fac84f7ec0338a93a9cda26016354d17b2cc Mon Sep 17 00:00:00 2001
From: Brandon Williams <turbine.bmw@gmail.com>
Date: Sat, 17 Oct 2026 15:42:54 -0400
Subject: [PATCH 2365/2368] media: imx681: match the validated ISP sensor gain
 interface

The older N1X Surface experiment exposes linear gain in 1/256 units. The working inline IFE userspace expects the Sony register code and converts gain as 1024/(1024-code). Restore that paired interface for this isolated ISP port. The resulting sensor source matches the validated SP11 source before its timing corrections. This is an experimental ABI change relative to the N1X simple-pipeline fixture; deploy only with matching userspace.

diff --git a/drivers/media/i2c/imx681.c b/drivers/media/i2c/imx681.c
index d5046ec18180e70cc6b10a39eb0a41f08a9ce534..938b0b0ef1afd92a20a60d5f6f91f4766554dcc3 100644
--- a/drivers/media/i2c/imx681.c
+++ b/drivers/media/i2c/imx681.c
@@ -41,16 +41,17 @@
 #define IMX681_FRAME_LENGTH_DEF	2708
 #define IMX681_FRAME_LENGTH_MAX	0xffff
 #define IMX681_EXPOSURE_MARGIN	48
-/* Start at a full frame of exposure and 4x analogue gain. */
-#define IMX681_EXPOSURE_DEF	(IMX681_FRAME_LENGTH_DEF - IMX681_EXPOSURE_MARGIN)
 /*
- * The analogue gain register holds a code with gain = 1024 / (1024 - code).
- * V4L2_CID_ANALOGUE_GAIN is linear in 1/256 steps (256 = 1x, 4096 = 16x) so
- * that userspace without a sensor-specific gain model computes it correctly.
+ * Start as an indoor camera would be set: a full frame of exposure and 4x
+ * analogue gain. The software ISP's auto gain steps multiplicatively and
+ * damped from whatever the controls hold, and the sensor's own reset (1x
+ * gain, a short exposure) left it climbing for 10 to 15 seconds after a
+ * cold boot in a normally lit room. The controls persist across opens, so
+ * only the first run after boot starts from these.
  */
-#define IMX681_AGAIN_ONE	256
-#define IMX681_AGAIN_DEF	(4 * IMX681_AGAIN_ONE)
-#define IMX681_AGAIN_MAX	(16 * IMX681_AGAIN_ONE)
+#define IMX681_EXPOSURE_DEF	(IMX681_FRAME_LENGTH_DEF - IMX681_EXPOSURE_MARGIN)
+#define IMX681_AGAIN_DEF	768	/* 1024 / (1024 - 768) = 4x */
+#define IMX681_AGAIN_MAX	960	/* gain = 1024 / (1024 - code) */
 #define IMX681_DGAIN_DEF	0x0100
 #define IMX681_PIXEL_RATE	548571428
 /* V4L2 C-PHY link frequency is half the 2406-Msym/s symbol rate. */
@@ -184,9 +185,8 @@ static int imx681_s_ctrl(struct v4l2_ctrl *ctrl)
 			  &ret);
 		break;
 	case V4L2_CID_ANALOGUE_GAIN:
-		cci_write(sensor->regmap, IMX681_REG_ANALOG_GAIN,
-			  1024 - DIV_ROUND_CLOSEST(1024 * IMX681_AGAIN_ONE,
-						   ctrl->val), &ret);
+		cci_write(sensor->regmap, IMX681_REG_ANALOG_GAIN, ctrl->val,
+			  &ret);
 		break;
 	case V4L2_CID_DIGITAL_GAIN:
 		cci_write(sensor->regmap, IMX681_REG_DIGITAL_GAIN, ctrl->val,
@@ -253,9 +253,8 @@ static int imx681_init_controls(struct imx681 *sensor)
 				  IMX681_EXPOSURE_MARGIN, 1,
 				  IMX681_EXPOSURE_DEF);
 	sensor->again_ctrl =
-		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_ANALOGUE_GAIN,
-				  IMX681_AGAIN_ONE, IMX681_AGAIN_MAX, 1,
-				  IMX681_AGAIN_DEF);
+		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_ANALOGUE_GAIN, 0,
+				  IMX681_AGAIN_MAX, 1, IMX681_AGAIN_DEF);
 	sensor->dgain_ctrl =
 		v4l2_ctrl_new_std(hdl, ops, V4L2_CID_DIGITAL_GAIN, 0x0100,
 				  0x0fff, 1, IMX681_DGAIN_DEF);
