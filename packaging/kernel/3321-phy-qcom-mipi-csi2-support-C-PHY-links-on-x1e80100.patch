From 3fb91375d8453a5161b1c923557c5a1981dc0f27 Mon Sep 17 00:00:00 2001
From: Brandon Williams <turbine.bmw@gmail.com>
Date: Tue, 13 Oct 2026 19:28:04 -0400
Subject: [PATCH 2321/2368] phy: qcom-mipi-csi2: support C-PHY links on
 x1e80100

The binding already accepts bus-type MEDIA_BUS_TYPE_CSI2_CPHY on the
sensor port, but the driver rejected anything other than D-PHY in
set_mode() and in the endpoint parser.

Accept C-PHY endpoints, where each data-lanes entry names a trio, accept
PHY_MODE_MIPI_CPHY, and reuse the D-PHY configure option block for C-PHY
with @lanes counting trios and @hs_clk_rate carrying the link frequency
that the clock rates are scaled from; the D-PHY timing fields are not
validated in that mode.

For the lane programming, replay the bounded x1e80100 C-PHY register
observation already used by the legacy camss CSIPHY path: reset, toggle,
common and configuration sequences at power-on, shutdown sequence at
power-off. The sequence covers the first trio only; other trio positions
are rejected until they have been observed.

Signed-off-by: Brandon Williams <turbine.bmw@gmail.com>
(cherry picked from commit 265c1969d627e80ba6532c44e8f2cdbb81dc953d)

diff --git a/drivers/phy/qualcomm/phy-qcom-mipi-csi2-3ph-dphy.c b/drivers/phy/qualcomm/phy-qcom-mipi-csi2-3ph-dphy.c
index 966d79c98f9b21e1a235b8397c4c84b25d869427..83c547f57ffb1ff1cb26deddc8f1fa76aa6613cd 100644
--- a/drivers/phy/qualcomm/phy-qcom-mipi-csi2-3ph-dphy.c
+++ b/drivers/phy/qualcomm/phy-qcom-mipi-csi2-3ph-dphy.c
@@ -12,6 +12,7 @@
 #include <linux/time64.h>
 
 #include "phy-qcom-mipi-csi2.h"
+#include "phy-qcom-mipi-csi2-x1e80100-cphy.h"
 
 #define CSIPHY_3PH_CMN_CSI_COMMON_CTRLn(offset, n)	((offset) + 0x4 * (n))
 #define CSIPHY_3PH_CMN_CSI_COMMON_CTRL0_PHY_SW_RESET	BIT(0)
@@ -268,6 +269,79 @@ phy_qcom_mipi_csi2_gen2_config_lanes(struct mipi_csi2phy_device *csi2phy,
 	}
 }
 
+/*
+ * phy_qcom_mipi_csi2_write_observed - Replay a bounded runtime observation
+ * @csi2phy: CSIPHY device
+ * @table: address/value/delay triples
+ * @num_entries: number of triples
+ *
+ * The x1e80100 C-PHY tables were transcribed from runtime MMIO observation
+ * of the PHY while a C-PHY sensor streamed. Each entry is replayed in order
+ * with the delay the observed writer used.
+ */
+static void
+phy_qcom_mipi_csi2_write_observed(struct mipi_csi2phy_device *csi2phy,
+				  const struct x1e80100_cphy_reg *table,
+				  unsigned int num_entries)
+{
+	unsigned int i;
+
+	for (i = 0; i < num_entries; i++) {
+		u32 delay_us;
+
+		writel(table[i].reg_data, csi2phy->base + table[i].reg_addr);
+
+		if (!table[i].delay_ns)
+			continue;
+
+		/* The observed writer floors nanoseconds and enforces 1 us */
+		delay_us = max_t(u32, table[i].delay_ns / NSEC_PER_USEC, 1);
+		if (delay_us <= 50)
+			udelay(delay_us);
+		else
+			usleep_range(delay_us,
+				     delay_us + max(delay_us / 100, 10U));
+	}
+}
+
+/*
+ * phy_qcom_mipi_csi2_cphy_enable_x1e80100 - Bring up one C-PHY trio
+ * @csi2phy: CSIPHY device
+ * @cfg: stream configuration
+ *
+ * The sequence is specific to the first trio on the 4 nm 3-phase PHY as
+ * observed on the Surface Pro 11. The data-lanes position is not yet used
+ * to select other trios.
+ */
+static int
+phy_qcom_mipi_csi2_cphy_enable_x1e80100(struct mipi_csi2phy_device *csi2phy,
+					struct mipi_csi2phy_stream_cfg *cfg)
+{
+	if (cfg->num_data_lanes != 1 || cfg->lane_cfg.data[0].pos != 0) {
+		dev_err(csi2phy->dev,
+			"C-PHY: only a single trio at position 1 is supported\n");
+		return -EOPNOTSUPP;
+	}
+
+	phy_qcom_mipi_csi2_write_observed(csi2phy, x1e80100_cphy_reset,
+					  ARRAY_SIZE(x1e80100_cphy_reset));
+	phy_qcom_mipi_csi2_write_observed(csi2phy, x1e80100_cphy_toggle,
+					  ARRAY_SIZE(x1e80100_cphy_toggle));
+	phy_qcom_mipi_csi2_write_observed(csi2phy, x1e80100_cphy_common,
+					  ARRAY_SIZE(x1e80100_cphy_common));
+	phy_qcom_mipi_csi2_write_observed(csi2phy, x1e80100_cphy_config,
+					  ARRAY_SIZE(x1e80100_cphy_config));
+
+	return 0;
+}
+
+static void
+phy_qcom_mipi_csi2_cphy_disable_x1e80100(struct mipi_csi2phy_device *csi2phy)
+{
+	phy_qcom_mipi_csi2_write_observed(csi2phy, x1e80100_cphy_shutdown,
+					  ARRAY_SIZE(x1e80100_cphy_shutdown));
+}
+
 static int phy_qcom_mipi_csi2_lanes_enable(struct mipi_csi2phy_device *csi2phy,
 					   struct mipi_csi2phy_stream_cfg *cfg)
 {
@@ -280,6 +354,9 @@ static int phy_qcom_mipi_csi2_lanes_enable(struct mipi_csi2phy_device *csi2phy,
 	if (cfg->link_freq <= 0)
 		return -EINVAL;
 
+	if (cfg->is_cphy)
+		return phy_qcom_mipi_csi2_cphy_enable_x1e80100(csi2phy, cfg);
+
 	settle_cnt = phy_qcom_mipi_csi2_settle_cnt_calc(cfg->link_freq, csi2phy->timer_clk_rate);
 	if (!settle_cnt)
 		return -ENODEV;
@@ -338,6 +415,11 @@ phy_qcom_mipi_csi2_lanes_disable(struct mipi_csi2phy_device *csi2phy,
 {
 	const struct mipi_csi2phy_device_regs *regs = csi2phy_dev_to_regs(csi2phy);
 
+	if (cfg->is_cphy) {
+		phy_qcom_mipi_csi2_cphy_disable_x1e80100(csi2phy);
+		return;
+	}
+
 	writel(0, csi2phy->base +
 	       CSIPHY_3PH_CMN_CSI_COMMON_CTRLn(regs->common_regs_offset, 5));
 
diff --git a/drivers/phy/qualcomm/phy-qcom-mipi-csi2-core.c b/drivers/phy/qualcomm/phy-qcom-mipi-csi2-core.c
index c0a4fa20eaf0c87f6c18b35e625f5ba1769c94e7..14cde50246dd9da3fd947f8970bd4905d8ba49dc 100644
--- a/drivers/phy/qualcomm/phy-qcom-mipi-csi2-core.c
+++ b/drivers/phy/qualcomm/phy-qcom-mipi-csi2-core.c
@@ -104,9 +104,23 @@ static int phy_qcom_mipi_csi2_configure(struct phy *phy,
 	struct mipi_csi2phy_stream_cfg *stream_cfg = &csi2phy->stream_cfg;
 	int ret;
 
-	ret = phy_mipi_dphy_config_validate(dphy_cfg);
-	if (ret)
-		return ret;
+	/*
+	 * C-PHY reuses the D-PHY option block: @lanes counts trios and
+	 * @hs_clk_rate carries the link frequency the consumer derived from
+	 * the sensor, which is what the PHY clock rates are scaled from.
+	 * The D-PHY timing fields do not apply and are not validated.
+	 */
+	if (csi2phy->phy_mode == PHY_MODE_MIPI_CPHY) {
+		if (!stream_cfg->is_cphy)
+			return -EINVAL;
+	} else {
+		if (stream_cfg->is_cphy)
+			return -EINVAL;
+
+		ret = phy_mipi_dphy_config_validate(dphy_cfg);
+		if (ret)
+			return ret;
+	}
 
 	if (dphy_cfg->lanes < 1 || dphy_cfg->lanes > CSI2_MAX_DATA_LANES)
 		return -EINVAL;
@@ -124,7 +138,7 @@ static int phy_qcom_mipi_csi2_set_mode(struct phy *phy,
 {
 	struct mipi_csi2phy_device *csi2phy = phy_get_drvdata(phy);
 
-	if (mode != PHY_MODE_MIPI_DPHY)
+	if (mode != PHY_MODE_MIPI_DPHY && mode != PHY_MODE_MIPI_CPHY)
 		return -EOPNOTSUPP;
 
 	csi2phy->phy_mode = mode;
@@ -258,6 +272,7 @@ static int phy_qcom_mipi_csi2_parse_routing(struct mipi_csi2phy_device *csi2phy)
 	struct fwnode_handle *ep;
 	int num_polarities;
 	int num_data_lanes;
+	int max_lanes;
 	u32 bus_type;
 	int i, ret;
 
@@ -278,14 +293,23 @@ static int phy_qcom_mipi_csi2_parse_routing(struct mipi_csi2phy_device *csi2phy)
 	bus_type = MEDIA_BUS_TYPE_CSI2_DPHY;
 	fwnode_property_read_u32(ep, "bus-type", &bus_type);
 
-	if (bus_type != MEDIA_BUS_TYPE_CSI2_DPHY) {
+	switch (bus_type) {
+	case MEDIA_BUS_TYPE_CSI2_DPHY:
+		max_lanes = CSI2_MAX_DATA_LANES;
+		break;
+	case MEDIA_BUS_TYPE_CSI2_CPHY:
+		stream_cfg->is_cphy = true;
+		max_lanes = CSI2_MAX_CPHY_TRIOS;
+		break;
+	default:
 		ret = -EOPNOTSUPP;
 		dev_err(dev, "Unsupported bus-type %u\n", bus_type);
 		goto out_put;
 	}
 
+	/* For C-PHY each data-lanes entry names a trio */
 	num_data_lanes = fwnode_property_count_u32(ep, "data-lanes");
-	if (num_data_lanes < 1 || num_data_lanes > CSI2_MAX_DATA_LANES) {
+	if (num_data_lanes < 1 || num_data_lanes > max_lanes) {
 		ret = -EINVAL;
 		dev_err(dev, "Invalid data-lanes count: %d\n", num_data_lanes);
 		goto out_put;
@@ -322,7 +346,7 @@ static int phy_qcom_mipi_csi2_parse_routing(struct mipi_csi2phy_device *csi2phy)
 	csi2phy->stream_cfg.lane_cfg.clk.pol = lane_polarities[0];
 
 	for (i = 0; i < csi2phy->stream_cfg.num_data_lanes; i++) {
-		if (data_lanes[i] < 1 || data_lanes[i] > CSI2_MAX_DATA_LANES) {
+		if (data_lanes[i] < 1 || data_lanes[i] > max_lanes) {
 			dev_err(dev, "Invalid lane %d\n", data_lanes[i]);
 			ret = -EINVAL;
 			goto out_put;
