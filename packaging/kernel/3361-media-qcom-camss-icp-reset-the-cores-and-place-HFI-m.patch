From ed4447434a89773ed53b10cf2a43f3702b1e9651 Mon Sep 17 00:00:00 2001
From: Brandon Williams <turbine.bmw@gmail.com>
Date: Thu, 15 Oct 2026 09:53:58 -0400
Subject: [PATCH 2361/2368] media: qcom: camss: icp: reset the cores and place
 HFI memory at fixed addresses

Before loading the firmware, shut down any image TZ still holds and pulse
the ICP, BPS and IPE block resets; a failed or crashed image is otherwise
left behind (the next one never reports ready).

Map the HFI memory where the firmware expects it, below the IO windows
it uses for image buffers, as the downstream camera SMMU layout does:
shared memory 0x07400000 up to the firmware-uncached region at
0x10000000 (secondary heap, queue table, queues, failure reason), QDSS
at 0x10b00000. A large shared region placed by the DMA allocator lands
inside the IO windows and the firmware's start-up never completes.

Lab interface: mirror lab buffers into the IPE/BPS domain once (they
share one group).

Signed-off-by: Brandon Williams <turbine.bmw@gmail.com>
Assisted-by: Claude:claude-opus-5-5
(cherry picked from commit 87fcb96980b5acd2a046df3e2e9f8f76e52a87b9)

diff --git a/drivers/media/platform/qcom/camss/camss-icp-hfi.c b/drivers/media/platform/qcom/camss/camss-icp-hfi.c
index 39f4d89382c72bf2b79fadf74bfa94ba1f2553aa..f0394b44f35dd704420922888a61ca8e337110e9 100644
--- a/drivers/media/platform/qcom/camss/camss-icp-hfi.c
+++ b/drivers/media/platform/qcom/camss/camss-icp-hfi.c
@@ -11,6 +11,7 @@
 #include <linux/delay.h>
 #include <linux/dma-mapping.h>
 #include <linux/io.h>
+#include <linux/iommu.h>
 #include <linux/sizes.h>
 #include <linux/slab.h>
 #include <linux/string.h>
@@ -41,20 +42,56 @@ static u32 hfi_q_bytes[HFI_Q_MAX] = {
 	[HFI_Q_DBG_TYPE] = HFI_DBG_Q_BYTES,
 };
 
-static int hfi_alloc(struct icp_hfi *hfi, struct icp_hfi_mem_region *r, size_t size)
+/*
+ * The firmware expects its memory at fixed addresses below the IO windows it
+ * uses for image buffers (as in the camera SMMU layout of the downstream
+ * driver): shared 0x07400000, firmware-uncached (secondary heap, queues)
+ * 0x10000000, QDSS 0x10b00000. Allocate contiguous memory and map it there
+ * in the ICP's domain as well.
+ */
+#define HFI_IOVA_SHMEM			0x07400000
+#define HFI_IOVA_FWUNCACHED		0x10000000
+#define HFI_IOVA_QDSS			0x10b00000
+
+static int hfi_alloc(struct icp_hfi *hfi, struct icp_hfi_mem_region *r, size_t size,
+		     dma_addr_t fixed)
 {
-	r->vaddr = dma_alloc_coherent(hfi->dev, size, &r->dma_addr, GFP_KERNEL);
+	struct iommu_domain *dom = iommu_get_domain_for_dev(hfi->dev);
+	phys_addr_t phys;
+	int ret;
+
+	r->vaddr = dma_alloc_attrs(hfi->dev, size, &r->alloc_addr, GFP_KERNEL,
+				   DMA_ATTR_FORCE_CONTIGUOUS);
 	if (!r->vaddr)
 		return -ENOMEM;
 	r->size = size;
+	r->dma_addr = r->alloc_addr;
 	memset(r->vaddr, 0, size);
+
+	if (!fixed || !dom)
+		return 0;
+	phys = iommu_iova_to_phys(dom, r->alloc_addr);
+	ret = phys ? iommu_map(dom, fixed, phys, size, IOMMU_READ | IOMMU_WRITE, GFP_KERNEL)
+		   : -EFAULT;
+	if (ret) {
+		dev_err(hfi->dev, "HFI: cannot map %zu bytes at %pad: %d\n", size, &fixed, ret);
+		dma_free_attrs(hfi->dev, size, r->vaddr, r->alloc_addr, DMA_ATTR_FORCE_CONTIGUOUS);
+		r->vaddr = NULL;
+		return ret;
+	}
+	r->dma_addr = fixed;
 	return 0;
 }
 
 static void hfi_free(struct icp_hfi *hfi, struct icp_hfi_mem_region *r)
 {
-	if (r->vaddr)
-		dma_free_coherent(hfi->dev, r->size, r->vaddr, r->dma_addr);
+	struct iommu_domain *dom = iommu_get_domain_for_dev(hfi->dev);
+
+	if (!r->vaddr)
+		return;
+	if (r->dma_addr != r->alloc_addr && dom)
+		iommu_unmap(dom, r->dma_addr, r->size);
+	dma_free_attrs(hfi->dev, r->size, r->vaddr, r->alloc_addr, DMA_ATTR_FORCE_CONTIGUOUS);
 	r->vaddr = NULL;
 }
 
@@ -85,13 +122,13 @@ int icp_hfi_init_queues(struct icp_hfi *hfi)
 	mutex_init(&hfi->msg_lock);
 	init_completion(&hfi->cmd_complete);
 
-	ret = hfi_alloc(hfi, &m->shmem, res->shmem_size);
+	ret = hfi_alloc(hfi, &m->shmem, res->shmem_size, HFI_IOVA_SHMEM);
 	if (ret)
 		goto err;
-	ret = hfi_alloc(hfi, &m->qdss, res->qdss_size);
+	ret = hfi_alloc(hfi, &m->qdss, res->qdss_size, HFI_IOVA_QDSS);
 	if (ret)
 		goto err;
-	ret = hfi_alloc(hfi, &m->fwuncached, res->fwuncached_size);
+	ret = hfi_alloc(hfi, &m->fwuncached, res->fwuncached_size, HFI_IOVA_FWUNCACHED);
 	if (ret)
 		goto err;
 
diff --git a/drivers/media/platform/qcom/camss/camss-icp-hfi.h b/drivers/media/platform/qcom/camss/camss-icp-hfi.h
index c7e167081df72dc84a9ebade164317284b35c9b3..3d7a3aaa139d49f206b4fc13898f7630e96ce012 100644
--- a/drivers/media/platform/qcom/camss/camss-icp-hfi.h
+++ b/drivers/media/platform/qcom/camss/camss-icp-hfi.h
@@ -217,8 +217,9 @@ struct hfi_resources {
 
 struct icp_hfi_mem_region {
 	void *vaddr;
-	dma_addr_t dma_addr;
+	dma_addr_t dma_addr;	/* the address the firmware uses */
 	size_t size;
+	dma_addr_t alloc_addr;	/* the DMA API's own mapping, when remapped */
 };
 
 struct icp_hfi_mem {
diff --git a/drivers/media/platform/qcom/camss/camss-icp.c b/drivers/media/platform/qcom/camss/camss-icp.c
index 50b68b8875767adda7fc174560600c37dee92eeb..735601110b8dffb408b871c582bd12ad1bf99046 100644
--- a/drivers/media/platform/qcom/camss/camss-icp.c
+++ b/drivers/media/platform/qcom/camss/camss-icp.c
@@ -21,9 +21,11 @@
 #include <linux/platform_device.h>
 #include <linux/pm_domain.h>
 #include <linux/pm_runtime.h>
+#include <linux/reset.h>
 #include <linux/soc/qcom/mdt_loader.h>
 #include <linux/string.h>
 #include <linux/debugfs.h>
+#include <linux/of_platform.h>
 #include <linux/uaccess.h>
 
 #include "camss-icp.h"
@@ -82,6 +84,7 @@ struct camss_icp {
 	struct dev_pm_domain_list *pd_list;
 
 	struct clk_bulk_data clks[ICP_CLK_MAX];
+	struct reset_control_bulk_data resets[3];
 	struct icc_path *icc_path[HFI_MAX_ICC_PATHS];
 
 	struct icp_hfi hfi;
@@ -99,6 +102,8 @@ struct camss_icp {
 		dma_addr_t iova;
 		size_t size;
 	} lab_buf[16];
+	/* IPE/BPS DMA goes through their own SMMU streams: mirror lab buffers there */
+	struct iommu_domain *lab_mirror[2];
 
 	phys_addr_t fw_phys;
 	size_t fw_size;
@@ -353,6 +358,24 @@ static int icp_boot(struct camss_icp *icp)
 		goto err_clk;
 	}
 
+	/* a previous image that crashed or never came up is still held by TZ */
+	ret = qcom_scm_pas_shutdown(icp_res->pas_id);
+	dev_dbg(icp->dev, "PAS shutdown before load: %d\n", ret);
+
+	/*
+	 * Reset the ICP, BPS and IPE cores: after a firmware crash the ICP
+	 * otherwise keeps its old state and the new image never reports ready.
+	 */
+	ret = reset_control_bulk_assert(ARRAY_SIZE(icp->resets), icp->resets);
+	if (!ret) {
+		usleep_range(10, 20);
+		ret = reset_control_bulk_deassert(ARRAY_SIZE(icp->resets), icp->resets);
+	}
+	if (ret) {
+		dev_err(icp->dev, "core reset failed: %d\n", ret);
+		goto err_clk;
+	}
+
 	/* Configure interrupts */
 	writel(CIRQ_ALL, icp->cirq_base + CIRQ_OB_CLEAR);
 	writel(CIRQ_CMD_CLEAR, icp->cirq_base + CIRQ_OB_CMD);
@@ -479,6 +502,7 @@ static int icp_boot(struct camss_icp *icp)
 
 	return 0;
 err_hfi:
+	qcom_scm_pas_shutdown(icp_res->pas_id);
 	icp_hfi_deinit_queues(&icp->hfi);
 err_clk:
 	for (i = 0; i < icp_res->noc_num; i++) {
@@ -597,10 +621,22 @@ static ssize_t icp_lab_alloc_write(struct file *f, const char __user *ubuf,
 	}
 	if (b) {
 		size = PAGE_ALIGN(size);
-		b->vaddr = dma_alloc_coherent(icp->dev, size, &b->iova, GFP_KERNEL);
+		b->vaddr = dma_alloc_attrs(icp->dev, size, &b->iova, GFP_KERNEL,
+					   DMA_ATTR_FORCE_CONTIGUOUS);
 		if (b->vaddr) {
+			struct iommu_domain *own = iommu_get_domain_for_dev(icp->dev);
+			phys_addr_t phys = own ? iommu_iova_to_phys(own, b->iova) : 0;
+			int m;
+
 			b->size = size;
 			memset(b->vaddr, 0, size);
+			for (m = 0; m < ARRAY_SIZE(icp->lab_mirror); m++) {
+				if (!icp->lab_mirror[m] || !phys)
+					continue;
+				if (iommu_map(icp->lab_mirror[m], b->iova, phys, size,
+					      IOMMU_READ | IOMMU_WRITE, GFP_KERNEL))
+					dev_err(icp->dev, "lab: mirror %d of %pad failed\n", m, &b->iova);
+			}
 			snprintf(name, sizeof(name), "buf%d", i);
 			debugfs_create_file_size(name, 0600, icp->dbg, b, &icp_lab_buf_fops, size);
 		}
@@ -639,9 +675,26 @@ static const struct file_operations icp_lab_alloc_fops = {
 	.write = icp_lab_alloc_write,
 };
 
+static struct iommu_domain *icp_lab_peer_domain(struct camss_icp *icp, const char *compat)
+{
+	struct device_node *np = of_find_compatible_node(NULL, NULL, compat);
+	struct platform_device *pdev = np ? of_find_device_by_node(np) : NULL;
+	struct iommu_domain *dom = pdev ? iommu_get_domain_for_dev(&pdev->dev) : NULL;
+
+	dev_info(icp->dev, "lab: %s domain %p (type %d)\n", compat, dom, dom ? dom->type : -1);
+	if (pdev)
+		put_device(&pdev->dev);
+	of_node_put(np);
+	return dom;
+}
+
 static void icp_lab_init(struct camss_icp *icp)
 {
 	mutex_init(&icp->lab_lock);
+	icp->lab_mirror[0] = icp_lab_peer_domain(icp, "qcom,x1e80100-camss-ipe");
+	icp->lab_mirror[1] = icp_lab_peer_domain(icp, "qcom,x1e80100-camss-bps");
+	if (icp->lab_mirror[1] == icp->lab_mirror[0])
+		icp->lab_mirror[1] = NULL;	/* one group for both: map once */
 	icp->lab_resp = devm_kzalloc(icp->dev, ICP_LAB_MAX_PKT, GFP_KERNEL);
 	if (!icp->lab_resp)
 		return;
@@ -655,10 +708,17 @@ static void icp_lab_exit(struct camss_icp *icp)
 	int i;
 
 	debugfs_remove_recursive(icp->dbg);
-	for (i = 0; i < ARRAY_SIZE(icp->lab_buf); i++)
-		if (icp->lab_buf[i].vaddr)
-			dma_free_coherent(icp->dev, icp->lab_buf[i].size,
-					  icp->lab_buf[i].vaddr, icp->lab_buf[i].iova);
+	for (i = 0; i < ARRAY_SIZE(icp->lab_buf); i++) {
+		struct icp_lab_buf *b = &icp->lab_buf[i];
+		int m;
+
+		if (!b->vaddr)
+			continue;
+		for (m = 0; m < ARRAY_SIZE(icp->lab_mirror); m++)
+			if (icp->lab_mirror[m])
+				iommu_unmap(icp->lab_mirror[m], b->iova, b->size);
+		dma_free_attrs(icp->dev, b->size, b->vaddr, b->iova, DMA_ATTR_FORCE_CONTIGUOUS);
+	}
 }
 
 static int camss_icp_probe(struct platform_device *pdev)
@@ -722,6 +782,16 @@ static int camss_icp_probe(struct platform_device *pdev)
 		goto err_pd;
 	}
 
+	icp->resets[0].id = "icp";
+	icp->resets[1].id = "bps";
+	icp->resets[2].id = "ipe";
+	ret = devm_reset_control_bulk_get_exclusive(&pdev->dev, ARRAY_SIZE(icp->resets),
+						    icp->resets);
+	if (ret) {
+		dev_err(&pdev->dev, "Failed to get resets: %d\n", ret);
+		goto err_pd;
+	}
+
 	for (i = 0; i < icp_res->noc_num; i++) {
 		icp->icc_path[i] = devm_of_icc_get(&pdev->dev, icp_res->noc_names[i]);
 		if (IS_ERR(icp->icc_path[i])) {
@@ -809,7 +879,8 @@ static const struct camss_icp_resources x1e80100_icp_res = {
 	.noc_names = x1e80100_noc_names,
 	.noc_num = ARRAY_SIZE(x1e80100_noc_names),
 	.hfi_res = {
-		.shmem_size = SZ_1M,	 // change to 0x0FC00000 per downstream ?
+		/* shared region up to the firmware-uncached one at 0x10000000 */
+		.shmem_size = 0x10000000 - 0x07400000,
 		.qdss_size = SZ_1M,
 		.fwuncached_size = 7 * SZ_1M,
 		/*
