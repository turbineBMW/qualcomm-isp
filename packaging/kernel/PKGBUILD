export LOCALVERSION=""
# Experimental ISP port; SP11 acceptance checks passed; other boards unqualified.
# Derived from omacom/omarchy-pkgs c8a524abb172b5f92e89da839907d133cced4baf.
# Co-installs as linux-omarchy-isp; retains the Omarchy ARM kernel configuration.
# Maintainer: The Omarchy Authors
# Adopted from the Arch Linux linux package.

# The aarch64 build of linux-omarchy. It has a recipe of its own, in a folder
# of its own, and that folder's name is its pkgbase so the build and publish
# tooling can tell its files from the x86_64 recipe's. The packages it makes
# are linux-omarchy and linux-omarchy-headers, the names x86_64 has.
pkgbase=linux-omarchy-isp
_kernel=linux-omarchy-isp
pkgver=7.2.8
pkgrel=13.1
pkgdesc='Omarchy ARM kernel with experimental Qualcomm X1E IFE/ICP support'
url='https://omarchy.org'
arch=(
  aarch64
)
