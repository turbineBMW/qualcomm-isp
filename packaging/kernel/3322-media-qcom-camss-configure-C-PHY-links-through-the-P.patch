From 4a906dfcb78117961c158d5804f1856a1318a44a Mon Sep 17 00:00:00 2001
From: Brandon Williams <turbine.bmw@gmail.com>
Date: Tue, 13 Oct 2026 19:28:04 -0400
Subject: [PATCH 2322/2368] media: qcom: camss: configure C-PHY links through
 the PHY API

csiphy_stream_on() built a D-PHY configuration unconditionally, so a C-PHY
sensor behind a generic PHY could not stream. Select PHY_MODE_MIPI_CPHY
when the endpoint is C-PHY and pass the trio count and link frequency in
the shared option block instead of deriving D-PHY timings.

Signed-off-by: Brandon Williams <turbine.bmw@gmail.com>
(cherry picked from commit 513a21d448164645097e8def2fe937dca013363c)

diff --git a/drivers/media/platform/qcom/camss/camss-csiphy.c b/drivers/media/platform/qcom/camss/camss-csiphy.c
index aaed7d0309dd67b78bcca638aba52e5605ce1db4..e3f07113a12f69c45c8a0e7dabd820433326903e 100644
--- a/drivers/media/platform/qcom/camss/camss-csiphy.c
+++ b/drivers/media/platform/qcom/camss/camss-csiphy.c
@@ -331,6 +331,7 @@ static int csiphy_stream_on(struct csiphy_device *csiphy)
 	union phy_configure_opts dphy_opts = { 0 };
 	struct device *dev = csiphy->camss->dev;
 	u8 num_lanes = lncfg->num_data;
+	enum phy_mode mode;
 	s64 link_freq;
 	int ret;
 
@@ -344,15 +345,27 @@ static int csiphy_stream_on(struct csiphy_device *csiphy)
 		return -EINVAL;
 	}
 
-	ret = phy_mipi_dphy_get_default_config_for_hsclk(link_freq, num_lanes,
-							 dphy_cfg);
-	if (ret < 0) {
-		dev_err(dev, "Invalid config for link frequency %lld\n",
-			link_freq);
-		return ret;
+	if (csiphy->cfg.csi2->is_cphy) {
+		/*
+		 * C-PHY: @lanes counts trios and @hs_clk_rate carries the
+		 * link frequency; the D-PHY timings do not apply.
+		 */
+		dphy_cfg->lanes = num_lanes;
+		dphy_cfg->hs_clk_rate = link_freq;
+		mode = PHY_MODE_MIPI_CPHY;
+	} else {
+		ret = phy_mipi_dphy_get_default_config_for_hsclk(link_freq,
+								 num_lanes,
+								 dphy_cfg);
+		if (ret < 0) {
+			dev_err(dev, "Invalid config for link frequency %lld\n",
+				link_freq);
+			return ret;
+		}
+		mode = PHY_MODE_MIPI_DPHY;
 	}
 
-	ret = phy_set_mode(csiphy->phy, PHY_MODE_MIPI_DPHY);
+	ret = phy_set_mode(csiphy->phy, mode);
 	if (ret) {
 		dev_err(dev, "Failed to set phy mode\n");
 		return ret;
@@ -360,7 +373,8 @@ static int csiphy_stream_on(struct csiphy_device *csiphy)
 
 	ret = phy_configure(csiphy->phy, &dphy_opts);
 	if (ret) {
-		dev_err(dev, "failed to configure MIPI D-PHY\n");
+		dev_err(dev, "failed to configure MIPI %c-PHY\n",
+			csiphy->cfg.csi2->is_cphy ? 'C' : 'D');
 		goto error;
 	}
 
