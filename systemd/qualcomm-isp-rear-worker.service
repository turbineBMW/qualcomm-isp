[Unit]
ConditionPathExists=/etc/qualcomm-isp/rear.json
ConditionPathExists=/usr/share/doc/linux-omarchy-isp/build-artifacts.json
Description=Qualcomm ISP rear camera worker (privileged session on demand)
Requires=qualcomm-isp-rear-worker.socket
After=qualcomm-isp-rear-worker.socket

[Service]
Environment=QUALCOMM_ISP_CONFIG=/etc/qualcomm-isp/rear.json
# Capture uses the packaged runtime and the connecting desktop UID.
# 30 fps until analogue gain is exhausted (knee 16); only then may the frame extend
# toward 1/15 s, before any sensor digital gain.
ExecStart=/usr/bin/python3 -I /usr/lib/qualcomm-isp/ipe-workerd.py --sessions /var/lib/qualcomm-isp/rear-sessions --state-file /var/lib/qualcomm-isp/rear-last-controls.json --session-args --adaptive --centre-priority --quiet --retain-frames 3000 --slow-frame 2.0 --slow-frame-gain 16 --sensor-digital-max 1 --awb-warmth-table "" --awb-warmth 0 --awb-warmth-blue 0
StateDirectory=qualcomm-isp
RuntimeDirectory=qualcomm-isp/rear-capture
RuntimeDirectoryMode=0755
# The socket unit owns /run/qualcomm-isp; removing it here breaks activation.
KillMode=mixed
TimeoutStopSec=90
