[Unit]
ConditionPathExists=/etc/qualcomm-isp/rear.json
ConditionPathExists=/usr/lib/modules/%v/qualcomm-isp-manifest.json
Description=Qualcomm ISP rear camera node (PipeWire, starts the worker on demand)
After=pipewire.service wireplumber.service
Requires=pipewire.service

[Service]
Environment=QUALCOMM_ISP_CONFIG=/etc/qualcomm-isp/rear.json
ExecStart=/usr/bin/python3 -I /usr/lib/qualcomm-isp/ipe-pipewire.py --standby --worker-socket /run/qualcomm-isp/rear-control
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
