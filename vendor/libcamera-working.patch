+++ w/src/apps/cam/lease_sink.h
@@ -0,0 +1,40 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+
+#include <chrono>
+#include <map>
+#include <string>
+#include <vector>
+
+#include "frame_sink.h"
+
+/* Private lab transport. Completion grants a CPU-read lease; only a matching
+ * ACK permits request reuse. No IPE import or implicit fencing is claimed. */
+class LeaseSink : public FrameSink
+{
+public:
+	explicit LeaseSink(const std::string &path);
+	~LeaseSink();
+	int configure(const libcamera::CameraConfiguration &config) override;
+	void mapBuffer(libcamera::FrameBuffer *buffer) override;
+	int start() override;
+	int stop() override;
+	bool processRequest(libcamera::Request *request) override;
+
+private:
+	struct Lease {
+		libcamera::Request *request;
+		uint64_t sequence;
+		std::chrono::steady_clock::time_point since;
+	};
+	bool send(const std::string &text, const std::vector<int> &fds = {});
+	void receive();
+	void fail(const char *reason);
+	std::string path_;
+	int fd_ = -1;
+	bool failed_ = false;
+	std::vector<libcamera::FrameBuffer *> buffers_;
+	std::map<unsigned int, Lease> leases_;
+	uint64_t sent_ = 0, released_ = 0;
+	size_t maxPending_ = 0;
+};
