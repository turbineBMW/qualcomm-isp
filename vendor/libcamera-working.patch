new file mode 100644
index 0000000000000000000000000000000000000000..ecf4c237ab3f429188ebc7a51a011d67c06751a5
--- /dev/null
+++ w/src/libcamera/pipeline/camss/camss_highlight_ae.h
@@ -0,0 +1,117 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/* Experimental native-4K RAW highlight constraint for the inline AE loop. */
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstdint>
+
+namespace libcamera {
+
+class CamssHighlightAe
+{
+public:
+	using Histogram = std::array<std::array<unsigned int, 1024>, 4>;
+	struct Stats {
+		Histogram full{};
+		Histogram centre{}; /* middle half of each native-4K axis */
+	};
+	struct Result {
+		bool valid = false;
+		double peak = 0;
+		double saturated = 0;
+		double photometric = 1;
+		double scale = 1;
+		double centrePeak = 0;
+		double centreSaturated = 0;
+	};
+
+	/* Call only with paired, fresh pixels and their applied controls. The
+	 * caller owns cadence, sensor settling and manual-control precedence. */
+	static Result evaluate(const Histogram &hist, const std::array<double, 2> &wb,
+			       double meanY, double targetY, unsigned int samples = 129600,
+			       double percentileFraction = 0.995, double clippingBudget = 0.001,
+			       double peakTarget = 0.80)
+	{
+		Result result;
+		if (!std::isfinite(meanY) || !std::isfinite(targetY) ||
+		    meanY < 0 || meanY > 255 || targetY <= 0 || targetY > 255 ||
+		    !samples || !std::isfinite(percentileFraction) ||
+		    percentileFraction <= 0 || percentileFraction > 1 ||
+		    !std::isfinite(clippingBudget) || clippingBudget <= 0 || clippingBudget > 0.05 ||
+		    !std::isfinite(peakTarget) || peakTarget < 0.5 || peakTarget > 0.98)
+			return result;
+		for (double gain : wb)
+			if (!std::isfinite(gain) || gain < 0.25 || gain > 4)
+				return result;
+		std::array<double, 4> gains = { wb[0], 1, 1, wb[1] };
+		for (unsigned int c = 0; c < 4; c++) {
+			uint64_t count = 0, saturated = 0;
+			unsigned int percentile = 0;
+			for (unsigned int code = 0; code < 1024; code++) {
+				count += hist[c][code];
+				if (count < static_cast<uint64_t>(std::ceil(samples * percentileFraction)))
+					percentile = code + 1;
+				if (code >= 1020)
+					saturated += hist[c][code];
+			}
+			if (count != samples)
+				return result;
+			result.peak = std::max(result.peak,
+				std::max(static_cast<int>(percentile) - 64, 0) * gains[c] / 1024.0);
+			result.saturated = std::max(result.saturated, saturated / static_cast<double>(samples));
+		}
+		/* Retain the existing luma feedback model; the RAW ceiling is in
+		 * linear sensor units. Neither is a reconstruction of Windows AE. */
+		result.photometric = std::clamp(std::pow(targetY / std::max(meanY, 1.0), 1.32), 0.5, 2.0);
+		if (std::abs(std::log(result.photometric)) < 0.02)
+			result.photometric = 1;
+		/* Hold within 2.5% of the peak target; otherwise scale towards it. */
+		double ceiling = result.peak >= peakTarget * 0.975 && result.peak <= peakTarget * 1.025
+			? 1.0 : peakTarget / std::max(result.peak, 0.001);
+		/* Approach the 0.1% clipping budget continuously. The old fixed
+		 * 30% cut at that boundary repeatedly darkened backlit scenes,
+		 * then let photometric AE grow exposure straight back again.
+		 * Hold in a small band; use a damped correction above it. */
+		if (result.saturated >= clippingBudget * 0.8) {
+			double clipping = result.saturated <= clippingBudget * 1.2 ? 1.0
+				: std::pow(clippingBudget / result.saturated, 0.25);
+			ceiling = std::min(ceiling, clipping);
+		}
+		/* Fine tracking steps stay at 12%; a start far below target (more
+		 * than half a stop) may take 50% steps so a dark room converges in
+		 * a few updates instead of thirty. The highlight ceiling still caps
+		 * every step. */
+		double upper = result.photometric > 1.5 ? 1.5 : 1.12;
+		result.scale = std::clamp(std::min(result.photometric, ceiling), 0.5, upper);
+		result.valid = true;
+		return result;
+	}
+
+	static Result evaluate(const Stats &stats, const std::array<double, 2> &wb,
+			       double meanY, double targetY, bool centrePriority,
+			       double peakTarget = 0.80, double peripheralClipping = 0.01,
+			       double centreClipping = 0.001, double centrePercentile = 0.995)
+	{
+		if (!centrePriority)
+			return evaluate(stats.full, wb, meanY, targetY, 129600, 0.995, 0.001, peakTarget);
+		for (unsigned int c = 0; c < 4; c++)
+			for (unsigned int b = 0; b < 1024; b++)
+				if (stats.centre[c][b] > stats.full[c][b])
+					return {};
+		/* This is a centre-priority policy, not face detection. Allow a
+		 * limited bright peripheral area while retaining strict central
+		 * protection and a whole-frame ceiling. Missing centre data must
+		 * never silently relax the conservative limit. */
+		auto whole = evaluate(stats.full, wb, meanY, targetY, 129600, 0.98, peripheralClipping, peakTarget);
+		auto centre = evaluate(stats.centre, wb, meanY, targetY, 32400, centrePercentile, centreClipping, peakTarget);
+		whole.valid = whole.valid && centre.valid;
+		whole.centrePeak = centre.peak;
+		whole.centreSaturated = centre.saturated;
+		whole.scale = whole.valid ? std::min(whole.scale, centre.scale) : 1;
+		return whole;
+	}
+};
+
+} /* namespace libcamera */
