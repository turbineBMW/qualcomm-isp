@@ -0,0 +1,288 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/* Experimental IMX681 native-4K paired Bayer statistics recorder. */
+#include "camss_raw_stats.h"
+
+#include <array>
+#include <cerrno>
+#include <cstdlib>
+#include <cstring>
+#include <filesystem>
+
+#include <linux/dma-buf.h>
+#include <sys/ioctl.h>
+
+#include <libcamera/base/log.h>
+#include <libcamera/control_ids.h>
+#include <libcamera/controls.h>
+
+#include "libcamera/internal/mapped_framebuffer.h"
+
+namespace libcamera {
+
+LOG_DECLARE_CATEGORY(Camss)
+
+namespace {
+constexpr unsigned int kStride = 4800;
+constexpr unsigned int kRawBytes = kStride * 2640;
+constexpr unsigned int kStep = 8;
+
+unsigned int raw10(const uint8_t *row, unsigned int x)
+{
+	const uint8_t *group = row + (x / 4) * 5;
+	return (group[x % 4] << 2) | ((group[4] >> (2 * (x % 4))) & 3);
+}
+} /* namespace */
+
+CamssRawStats::CamssRawStats(V4L2VideoDevice *output, const std::string &directory)
+	: output_(output), directory_(directory)
+{
+	saveRaw_ = std::getenv("LIBCAMERA_CAMSS_RAW_SAVE") != nullptr;
+	output_->bufferReady.connect(this, &CamssRawStats::bufferReady);
+}
+
+CamssRawStats::~CamssRawStats()
+{
+	stop();
+	release();
+}
+
+int CamssRawStats::allocate()
+{
+	V4L2DeviceFormat fmt;
+	int ret = output_->getFormat(&fmt);
+	if (ret)
+		return ret;
+	if (fmt.size != Size(3840, 2640) || fmt.fourcc.toString() != "pRAA" ||
+	    fmt.planesCount != 1 || fmt.planes[0].bpl != kStride || fmt.planes[0].size < kRawBytes)
+		return -EINVAL;
+	ret = output_->exportBuffers(4, &buffers_);
+	if (ret < 0)
+		return ret;
+	ret = output_->importBuffers(4);
+	if (ret)
+		release();
+	return ret;
+}
+
+void CamssRawStats::release()
+{
+	maps_.clear();
+	if (!buffers_.empty()) {
+		output_->releaseBuffers();
+		buffers_.clear();
+	}
+}
+
+int CamssRawStats::start()
+{
+	std::string path = (std::filesystem::path(directory_) / "stats.jsonl").string();
+	log_ = fopen(path.c_str(), "wx");
+	if (!log_)
+		return -errno;
+	failed_ = false;
+	rawCount_ = outputCount_ = 0;
+	lastSequence_ = UINT32_MAX;
+	lastRaw_.clear();
+	wanted_.clear();
+	saved_.clear();
+	fprintf(log_, "{\"type\":\"header\",\"version\":1,\"raw_size\":[3840,2640],"
+		"\"stride\":4800,\"format\":\"RGGB10_CSI2P\",\"crop\":[0,240,3840,2160],"
+		"\"sample_step\":8,\"channels\":[\"R\",\"Gr\",\"Gb\",\"B\"],"
+		"\"centre_crop_in_output\":[960,540,1920,1080],\"centre_samples_per_channel\":32400,"
+		"\"tiles\":[8,6],\"black_level_assumption\":64,\"valid_quad_range_exclusive\":[72,1000],"
+		"\"timestamp\":\"buffer completion, not exposure start\"}\n");
+	for (const auto &buffer : buffers_) {
+		auto map = std::make_unique<MappedFrameBuffer>(buffer.get(), MappedFrameBuffer::MapFlag::Read);
+		if (!map->isValid()) {
+			failed_ = true;
+			stop();
+			return -ENOMEM;
+		}
+		maps_[buffer.get()] = std::move(map);
+		int ret = output_->queueBuffer(buffer.get());
+		if (ret) {
+			failed_ = true;
+			output_->streamOff();
+			stop();
+			return ret;
+		}
+	}
+	int ret = output_->streamOn();
+	if (ret) {
+		failed_ = true;
+		output_->streamOff();
+		stop();
+		return ret;
+	}
+	running_ = true;
+	return 0;
+}
+
+void CamssRawStats::stop()
+{
+	if (running_) {
+		running_ = false;
+		if (output_->streamOff())
+			failed_ = true;
+	}
+	/* Write retained full frames only after streaming has stopped. */
+	for (const auto &[request, data] : saved_) {
+		std::string path = (std::filesystem::path(directory_) /
+			("request-" + std::to_string(request) + ".raw10")).string();
+		FILE *file = fopen(path.c_str(), "wx");
+		if (!file) {
+			failed_ = true;
+			continue;
+		}
+		if (fwrite(data.data(), 1, data.size(), file) != data.size())
+			failed_ = true;
+		if (fclose(file))
+			failed_ = true;
+	}
+	saved_.clear();
+	lastRaw_.clear();
+	if (log_) {
+		if (ferror(log_))
+			failed_ = true;
+		fprintf(log_, "{\"type\":\"end\",\"raw_frames\":%u,\"output_frames\":%u,\"failed\":%s}\n",
+			rawCount_, outputCount_, failed_ ? "true" : "false");
+		if (fclose(log_))
+			failed_ = true;
+		log_ = nullptr;
+	}
+	if (failed_)
+		LOG(Camss, Error) << "Paired RAW statistics recording failed";
+}
+
+void CamssRawStats::recordOutput(FrameBuffer *buffer, unsigned int request, const ControlList &metadata)
+{
+	if (!log_)
+		return;
+	const auto &meta = buffer->metadata();
+	auto exposure = metadata.get(controls::ExposureTime);
+	auto gain = metadata.get(controls::AnalogueGain);
+	auto wb = metadata.get(controls::ColourGains);
+	bool valid = meta.status == FrameMetadata::FrameSuccess && exposure && gain && wb;
+	fprintf(log_, "{\"type\":\"nv12\",\"request\":%u,\"sequence\":%u,\"timestamp_ns\":%llu,"
+		"\"metadata_valid\":%s,\"exposure_us\":%d,\"analogue_gain\":%.9g,\"colour_gains\":[%.9g,%.9g]}\n",
+		request, meta.sequence, static_cast<unsigned long long>(meta.timestamp), valid ? "true" : "false",
+		exposure.value_or(0), gain.value_or(0), wb ? (*wb)[0] : 0, wb ? (*wb)[1] : 0);
+	outputCount_++;
+	if (saveRaw_ && (request == 58 || request == 59) && meta.status == FrameMetadata::FrameSuccess) {
+		wanted_[meta.sequence] = request;
+		if (lastSequence_ == meta.sequence)
+			saved_[request] = lastRaw_;
+	}
+}
+
+void CamssRawStats::bufferReady(FrameBuffer *buffer)
+{
+	if (!running_)
+		return;
+	const auto &meta = buffer->metadata();
+	if (meta.status != FrameMetadata::FrameSuccess) {
+		failed_ = true;
+	} else if (meta.sequence != UINT32_MAX) {
+		auto &map = maps_.at(buffer);
+		int fd = buffer->planes()[0].fd.get();
+		struct dma_buf_sync sync = { DMA_BUF_SYNC_START | DMA_BUF_SYNC_READ };
+		if (map->planes()[0].size() < kRawBytes || meta.planes()[0].bytesused < kRawBytes ||
+		    ioctl(fd, DMA_BUF_IOCTL_SYNC, &sync) < 0) {
+			failed_ = true;
+		} else {
+			const uint8_t *data = map->planes()[0].data();
+			CamssHighlightAe::Stats stats;
+			auto &hist = stats.full;
+			struct Tile {
+				std::array<uint64_t, 4> sum{};
+				std::array<uint64_t, 4> validSum{};
+				unsigned int valid = 0;
+			};
+			std::array<Tile, 48> tiles{};
+			CamssBayerAwb::Stats awb{};
+			for (unsigned int y = 0; y < 2160; y += kStep) {
+				const uint8_t *row = data + (y + 240) * kStride;
+				for (unsigned int x = 0; x < 3840; x += kStep) {
+					std::array<unsigned int, 4> quad = {
+						raw10(row, x), raw10(row, x + 1),
+						raw10(row + kStride, x), raw10(row + kStride, x + 1)
+					};
+					if (awbStats_) {
+						auto &fine = awb[(y / 120) * CamssBayerAwb::kColumns + x / 120];
+						fine.count++;
+						bool neutralValid = true;
+						for (unsigned int value : quad)
+							neutralValid &= value > 72 && value < 1000;
+						if (neutralValid) {
+							fine.valid++;
+							for (unsigned int c = 0; c < 4; c++)
+								fine.sum[c] += quad[c] - 64;
+						}
+					}
+					Tile &tile = tiles[(y / 360) * 8 + x / 480];
+					bool valid = true;
+					for (unsigned int c = 0; c < 4; c++) {
+						hist[c][quad[c]]++;
+						if (x >= 960 && x < 2880 && y >= 540 && y < 1620)
+							stats.centre[c][quad[c]]++;
+						tile.sum[c] += quad[c];
+						valid &= quad[c] > 72 && quad[c] < 1000;
+					}
+					if (valid) {
+						tile.valid++;
+						for (unsigned int c = 0; c < 4; c++)
+							tile.validSum[c] += quad[c] - 64;
+					}
+				}
+			}
+			if (saveRaw_) {
+				lastSequence_ = meta.sequence;
+				lastRaw_.assign(data, data + kRawBytes);
+				auto it = wanted_.find(meta.sequence);
+				if (it != wanted_.end())
+					saved_[it->second] = lastRaw_;
+			}
+			sync.flags = DMA_BUF_SYNC_END | DMA_BUF_SYNC_READ;
+			if (ioctl(fd, DMA_BUF_IOCTL_SYNC, &sync) < 0)
+				failed_ = true;
+			fprintf(log_, "{\"type\":\"raw\",\"sequence\":%u,\"timestamp_ns\":%llu,\"histogram\":[",
+				meta.sequence, static_cast<unsigned long long>(meta.timestamp));
+			for (unsigned int c = 0; c < 4; c++) {
+				fprintf(log_, "%s[", c ? "," : "");
+				for (unsigned int b = 0; b < 1024; b++)
+					fprintf(log_, "%s%u", b ? "," : "", hist[c][b]);
+				fprintf(log_, "]");
+			}
+			fprintf(log_, "],\"centre_histogram\":[");
+			for (unsigned int c = 0; c < 4; c++) {
+				fprintf(log_, "%s[", c ? "," : "");
+				for (unsigned int b = 0; b < 1024; b++)
+					fprintf(log_, "%s%u", b ? "," : "", stats.centre[c][b]);
+				fprintf(log_, "]");
+			}
+			fprintf(log_, "],\"tiles\":[");
+			for (unsigned int t = 0; t < 48; t++) {
+				const auto &tile = tiles[t];
+				fprintf(log_, "%s{\"count\":2700,\"valid_count\":%u,\"sum\":[", t ? "," : "", tile.valid);
+				for (unsigned int c = 0; c < 4; c++)
+					fprintf(log_, "%s%llu", c ? "," : "", static_cast<unsigned long long>(tile.sum[c]));
+				fprintf(log_, "],\"valid_black_subtracted_sum\":[");
+				for (unsigned int c = 0; c < 4; c++)
+					fprintf(log_, "%s%llu", c ? "," : "", static_cast<unsigned long long>(tile.validSum[c]));
+				fprintf(log_, "]}");
+			}
+			fprintf(log_, "]}\n");
+			rawCount_++;
+			if (!failed_)
+				histogramReady.emit(meta.sequence, meta.timestamp, stats);
+			if (awbStats_ && !failed_)
+				statsReady.emit(meta.sequence, meta.timestamp, awb);
+		}
+	}
+	if (output_->queueBuffer(buffer)) {
+		failed_ = true;
+		LOG(Camss, Error) << "Cannot requeue paired RAW buffer";
+	}
+}
+
+} /* namespace libcamera */
