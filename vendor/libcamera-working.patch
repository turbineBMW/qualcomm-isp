diff --git i/src/libcamera/pipeline/camss/camss_bayer_awb.h w/src/libcamera/pipeline/camss/camss_bayer_awb.h
new file mode 100644
index 0000000000000000000000000000000000000000..38fd9e006d74c912d7ecbe326870418a9e6a2483
--- /dev/null
+++ w/src/libcamera/pipeline/camss/camss_bayer_awb.h
@@ -0,0 +1,355 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/* Conservative session-reference Bayer AWB experiment. */
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstdint>
+#include <utility>
+#include <vector>
+
+namespace libcamera {
+
+class CamssBayerAwb
+{
+public:
+	static constexpr unsigned int kColumns = 32;
+	static constexpr unsigned int kRows = 18;
+	struct Tile {
+		unsigned int count = 0;
+		unsigned int valid = 0;
+		std::array<uint64_t, 4> sum{}; /* black-subtracted R, Gr, Gb, B */
+	};
+	using Stats = std::array<Tile, kColumns * kRows>;
+	struct Result {
+		std::array<double, 2> gains{};
+		unsigned int selected = 0;
+		bool accepted = false;
+		const char *reason = "insufficient-neutral-support";
+		double cct = 0; /* locus mode: interpolated reference CCT */
+	};
+	struct LocusPoint {
+		double cct;
+		std::array<double, 2> logGains; /* log(G/R), log(G/B) of a neutral patch */
+	};
+
+	bool configure(const std::array<double, 2> &reference)
+	{
+		for (double g : reference)
+			if (!std::isfinite(g) || g < 0.25 || g > 4.0)
+				return false;
+		reference_ = reference;
+		anchored_ = true;
+		reset();
+		return true;
+	}
+
+	void reset() { stable_ = 0; }
+	const std::array<double, 2> &reference() const { return reference_; }
+
+	/*
+	 * Illuminant-locus mode. `flat` holds (cct, R/G, B/G) triples of neutral
+	 * references for this sensor. Tiles within `width` (log units) of the
+	 * polyline through those points, in CCT order, count as neutral
+	 * candidates; the estimate is the locus point at their median position.
+	 * When a measured session reference was configured, the locus is shifted
+	 * so it passes through that point at `anchorCct` (a module calibration
+	 * in place of OTP data). `warmth` keeps a share of a warm light's colour
+	 * below `warmCct`, growing linearly towards 2300 K.
+	 */
+	bool configureLocus(const std::vector<double> &flat, double width, double anchorCct,
+			    double warmth, double warmCct, double minGreen, double warmthBlue = -1)
+	{
+		if (warmthBlue < 0)
+			warmthBlue = warmth;
+		if (flat.size() < 6 || flat.size() % 3 || !(width > 0.01 && width < 0.5) ||
+		    !(minGreen >= 1) || !(warmth >= 0 && warmth <= 1) || !(warmthBlue >= 0 && warmthBlue <= 1) ||
+		    !(warmCct > 2300))
+			return false;
+		std::vector<LocusPoint> points;
+		for (unsigned int i = 0; i < flat.size(); i += 3) {
+			double cct = flat[i], rg = flat[i + 1], bg = flat[i + 2];
+			if (!(cct >= 1000 && cct <= 20000) || !(rg > 0.05 && rg < 20) || !(bg > 0.05 && bg < 20))
+				return false;
+			points.push_back({ cct, { std::log(1 / rg), std::log(1 / bg) } });
+		}
+		std::sort(points.begin(), points.end(),
+			  [](const LocusPoint &a, const LocusPoint &b) { return a.cct > b.cct; });
+		for (unsigned int i = 1; i < points.size(); i++)
+			if (points[i].cct == points[i - 1].cct)
+				return false;
+		if (anchored_) {
+			/* Shift so the locus passes through the measured neutral at anchorCct. */
+			std::array<double, 2> at = interpolate(points, position(points, anchorCct));
+			for (auto &pt : points)
+				for (unsigned int c = 0; c < 2; c++)
+					pt.logGains[c] += std::log(reference_[c]) - at[c];
+		}
+		locus_ = std::move(points);
+		locusWidth_ = width;
+		warmth_ = warmth;
+		warmthBlue_ = warmthBlue;
+		warmCct_ = warmCct;
+		minGreen_ = minGreen;
+		reset();
+		return true;
+	}
+
+	/*
+	 * Warmth as a function of CCT: (cct, redShare, blueShare) triples,
+	 * linearly interpolated, replacing the scalar warmth ramp. The shares
+	 * were fitted against the reference camera: it keeps little of a pure
+	 * tungsten cast but, in mixed window-plus-tungsten light, renders much
+	 * closer to the daylight reference than the locus median suggests.
+	 */
+	bool configureWarmthTable(const std::vector<double> &flat)
+	{
+		if (flat.empty()) {
+			warmthTable_.clear();
+			return true;
+		}
+		if (flat.size() < 6 || flat.size() % 3)
+			return false;
+		std::vector<std::array<double, 3>> table;
+		for (unsigned int i = 0; i < flat.size(); i += 3) {
+			if (!(flat[i] >= 1000 && flat[i] <= 20000) || !(flat[i + 1] >= 0 && flat[i + 1] <= 1) ||
+			    !(flat[i + 2] >= 0 && flat[i + 2] <= 1))
+				return false;
+			table.push_back({ flat[i], flat[i + 1], flat[i + 2] });
+		}
+		std::sort(table.begin(), table.end(), [](const auto &a, const auto &b) { return a[0] < b[0]; });
+		warmthTable_ = std::move(table);
+		return true;
+	}
+
+	std::array<double, 2> warmthAt(double cct) const
+	{
+		if (warmthTable_.empty()) {
+			double ramp = cct < warmCct_ ? std::clamp((warmCct_ - cct) / (warmCct_ - 2300.0), 0.0, 1.0) : 0.0;
+			return { warmth_ * ramp, warmthBlue_ * ramp };
+		}
+		const auto &t = warmthTable_;
+		if (cct <= t.front()[0])
+			return { t.front()[1], t.front()[2] };
+		if (cct >= t.back()[0])
+			return { t.back()[1], t.back()[2] };
+		for (unsigned int i = 1; i < t.size(); i++)
+			if (cct <= t[i][0]) {
+				double u = (cct - t[i - 1][0]) / (t[i][0] - t[i - 1][0]);
+				return { t[i - 1][1] * (1 - u) + t[i][1] * u, t[i - 1][2] * (1 - u) + t[i][2] * u };
+			}
+		return { 0, 0 };
+	}
+
+	bool locusMode() const { return !locus_.empty(); }
+	bool anchored() const { return anchored_; }
+
+	Result process(const Stats &stats, const std::array<double, 2> &current)
+	{
+		if (locusMode())
+			return processLocus(stats, current);
+		Result result;
+		result.gains = current;
+		std::array<std::vector<double>, 2> samples;
+		unsigned int minX = kColumns, minY = kRows, maxX = 0, maxY = 0;
+		for (unsigned int i = 0; i < stats.size(); i++) {
+			const Tile &t = stats[i];
+			if (!t.count || t.valid * 5 < t.count * 4 || !t.valid)
+				continue;
+			double r = t.sum[0], g = (t.sum[1] + t.sum[2]) / 2.0, b = t.sum[3];
+			if (r <= 0 || b <= 0 || g / t.valid < 64 ||
+			    std::abs(static_cast<double>(t.sum[1]) - t.sum[2]) > g * 0.05)
+				continue;
+			std::array<double, 2> gains = { g / r, g / b };
+			/* A session neutral reference, not a universal illuminant locus. */
+			if (std::abs(std::log(gains[0] / reference_[0])) > 0.06 ||
+			    std::abs(std::log(gains[1] / reference_[1])) > 0.06)
+				continue;
+			for (unsigned int c = 0; c < 2; c++)
+				samples[c].push_back(std::log(gains[c]));
+			minX = std::min(minX, i % kColumns);
+			maxX = std::max(maxX, i % kColumns);
+			minY = std::min(minY, i / kColumns);
+			maxY = std::max(maxY, i / kColumns);
+		}
+		result.selected = samples[0].size();
+		if (result.selected < 16 || maxX - minX + 1 < 4 || maxY - minY + 1 < 3) {
+			reset();
+			return result;
+		}
+		std::array<double, 2> target;
+		for (unsigned int c = 0; c < 2; c++) {
+			auto &values = samples[c];
+			std::sort(values.begin(), values.end());
+			double median = (values[(values.size() - 1) / 2] + values[values.size() / 2]) / 2;
+			for (double &v : values)
+				v = std::abs(v - median);
+			std::sort(values.begin(), values.end());
+			if (values[(values.size() - 1) * 9 / 10] > 0.03) {
+				reset();
+				result.reason = "inconsistent-neutral-colours";
+				return result;
+			}
+			target[c] = std::exp(median);
+			if (std::abs(std::log(target[c] / reference_[c])) > 0.05) {
+				reset();
+				result.reason = "outside-session-reference";
+				return result;
+			}
+		}
+		if (!stable_ || std::abs(std::log(target[0] / previous_[0])) > 0.02 ||
+		    std::abs(std::log(target[1] / previous_[1])) > 0.02)
+			stable_ = 1;
+		else
+			stable_ = std::min(stable_ + 1, 3u);
+		previous_ = target;
+		if (stable_ < 3) {
+			result.reason = "waiting-for-stable-neutral";
+			return result;
+		}
+		for (unsigned int c = 0; c < 2; c++) {
+			double step = std::clamp(0.2 * std::log(target[c] / current[c]), -0.02, 0.02);
+			result.gains[c] = std::clamp(current[c] * std::exp(step), 0.25, 4.0);
+		}
+		result.accepted = true;
+		result.reason = "neutral-tracking";
+		return result;
+	}
+
+private:
+	/* Continuous position along the locus polyline: index + fraction. */
+	static double position(const std::vector<LocusPoint> &points, double cct)
+	{
+		if (cct >= points.front().cct)
+			return 0;
+		for (unsigned int i = 1; i < points.size(); i++)
+			if (cct >= points[i].cct)
+				return i - 1 + (points[i - 1].cct - cct) / (points[i - 1].cct - points[i].cct);
+		return points.size() - 1;
+	}
+
+	static std::array<double, 2> interpolate(const std::vector<LocusPoint> &points, double t)
+	{
+		t = std::clamp(t, 0.0, points.size() - 1.0);
+		unsigned int i = std::min<unsigned int>(static_cast<unsigned int>(t), points.size() - 2);
+		double u = t - i;
+		return { points[i].logGains[0] * (1 - u) + points[i + 1].logGains[0] * u,
+			 points[i].logGains[1] * (1 - u) + points[i + 1].logGains[1] * u };
+	}
+
+	static double cctAt(const std::vector<LocusPoint> &points, double t)
+	{
+		t = std::clamp(t, 0.0, points.size() - 1.0);
+		unsigned int i = std::min<unsigned int>(static_cast<unsigned int>(t), points.size() - 2);
+		double u = t - i;
+		return points[i].cct * (1 - u) + points[i + 1].cct * u;
+	}
+
+	/* Nearest point on the polyline to a tile colour: distance and position. */
+	std::pair<double, double> nearest(const std::array<double, 2> &lg) const
+	{
+		double best = 1e9, bestT = 0;
+		for (unsigned int i = 0; i + 1 < locus_.size(); i++) {
+			const auto &a = locus_[i].logGains, &b = locus_[i + 1].logGains;
+			double dx = b[0] - a[0], dy = b[1] - a[1];
+			double len = dx * dx + dy * dy;
+			double u = len > 0 ? std::clamp(((lg[0] - a[0]) * dx + (lg[1] - a[1]) * dy) / len, 0.0, 1.0) : 0;
+			double px = a[0] + u * dx - lg[0], py = a[1] + u * dy - lg[1];
+			double d = std::sqrt(px * px + py * py);
+			if (d < best) {
+				best = d;
+				bestT = i + u;
+			}
+		}
+		return { best, bestT };
+	}
+
+	Result processLocus(const Stats &stats, const std::array<double, 2> &current)
+	{
+		Result result;
+		result.gains = current;
+		std::vector<double> positions;
+		unsigned int minX = kColumns, minY = kRows, maxX = 0, maxY = 0;
+		for (unsigned int i = 0; i < stats.size(); i++) {
+			const Tile &t = stats[i];
+			if (!t.count || t.valid * 5 < t.count * 4 || !t.valid)
+				continue;
+			double r = t.sum[0], g = (t.sum[1] + t.sum[2]) / 2.0, b = t.sum[3];
+			if (r <= 0 || b <= 0 || g / t.valid < minGreen_ ||
+			    std::abs(static_cast<double>(t.sum[1]) - t.sum[2]) > g * 0.05)
+				continue;
+			auto [distance, position] = nearest({ std::log(g / r), std::log(g / b) });
+			if (distance > locusWidth_)
+				continue;
+			positions.push_back(position);
+			minX = std::min(minX, i % kColumns);
+			maxX = std::max(maxX, i % kColumns);
+			minY = std::min(minY, i / kColumns);
+			maxY = std::max(maxY, i / kColumns);
+		}
+		result.selected = positions.size();
+		if (result.selected < 16 || maxX - minX + 1 < 4 || maxY - minY + 1 < 3) {
+			reset();
+			return result;
+		}
+		std::sort(positions.begin(), positions.end());
+		double median = (positions[(positions.size() - 1) / 2] + positions[positions.size() / 2]) / 2;
+		std::vector<double> spread;
+		for (double v : positions)
+			spread.push_back(std::abs(v - median));
+		std::sort(spread.begin(), spread.end());
+		/* More than one illuminant-like colour cluster (window daylight plus
+		 * tungsten): holding would keep whatever gains the session started
+		 * with. Move towards the median at half speed instead, as a mixed
+		 * light has no single right answer and the middle is what the
+		 * reference camera renders. */
+		bool mixed = spread[(spread.size() - 1) * 9 / 10] > 1.5;
+		std::array<double, 2> target = interpolate(locus_, median);
+		result.cct = cctAt(locus_, median);
+		{
+			/* Keep part of the cast: move each channel's gain part of the
+			 * way back to the daylight reference. The blue share is
+			 * separate because the colour matrix amplifies blue changes
+			 * more than red ones in the rendered image. */
+			std::array<double, 2> share = warmthAt(result.cct);
+			std::array<double, 2> neutral = anchored_ ? std::array<double, 2>{ std::log(reference_[0]), std::log(reference_[1]) }
+								: interpolate(locus_, position(locus_, 5000));
+			target[0] += share[0] * (neutral[0] - target[0]);
+			target[1] += share[1] * (neutral[1] - target[1]);
+		}
+		std::array<double, 2> goal = { std::exp(target[0]), std::exp(target[1]) };
+		if (!stable_ || std::abs(std::log(goal[0] / previous_[0])) > 0.03 ||
+		    std::abs(std::log(goal[1] / previous_[1])) > 0.03)
+			stable_ = 1;
+		else
+			stable_ = std::min(stable_ + 1, 3u);
+		previous_ = goal;
+		if (stable_ < 3) {
+			result.reason = "waiting-for-stable-neutral";
+			return result;
+		}
+		double limit = mixed ? 0.025 : 0.05;
+		for (unsigned int c = 0; c < 2; c++) {
+			double step = std::clamp((mixed ? 0.15 : 0.3) * std::log(goal[c] / current[c]), -limit, limit);
+			result.gains[c] = std::clamp(current[c] * std::exp(step), 0.25, 4.0);
+		}
+		result.accepted = true;
+		result.reason = mixed ? "mixed-illuminants" : "locus-tracking";
+		return result;
+	}
+
+	std::array<double, 2> reference_{ 1, 1 };
+	std::array<double, 2> previous_{ 1, 1 };
+	unsigned int stable_ = 0;
+	bool anchored_ = false;
+	std::vector<LocusPoint> locus_;
+	double locusWidth_ = 0.12;
+	double warmth_ = 0;
+	double warmthBlue_ = 0;
+	std::vector<std::array<double, 3>> warmthTable_;
+	double warmCct_ = 4500;
+	double minGreen_ = 64;
+};
+
+} /* namespace libcamera */
