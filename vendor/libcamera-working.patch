@@ -0,0 +1,57 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/* Experimental IMX681 native-4K paired Bayer statistics recorder. */
+#pragma once
+
+#include <cstdio>
+#include <map>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include <libcamera/geometry.h>
+#include <libcamera/base/signal.h>
+
+#include "camss_bayer_awb.h"
+#include "camss_highlight_ae.h"
+
+#include "libcamera/internal/v4l2_videodevice.h"
+
+namespace libcamera {
+
+class ControlList;
+class MappedFrameBuffer;
+
+class CamssRawStats
+{
+public:
+	CamssRawStats(V4L2VideoDevice *output, const std::string &directory);
+	~CamssRawStats();
+	int allocate();
+	void release();
+	int start();
+	void stop();
+	void recordOutput(FrameBuffer *buffer, unsigned int request, const ControlList &metadata);
+	void enableAwbStats() { awbStats_ = true; }
+	Signal<uint32_t, uint64_t, const CamssBayerAwb::Stats &> statsReady;
+	Signal<uint32_t, uint64_t, const CamssHighlightAe::Stats &> histogramReady;
+
+private:
+	void bufferReady(FrameBuffer *buffer);
+	V4L2VideoDevice *output_;
+	std::string directory_;
+	std::vector<std::unique_ptr<FrameBuffer>> buffers_;
+	std::map<FrameBuffer *, std::unique_ptr<MappedFrameBuffer>> maps_;
+	FILE *log_ = nullptr;
+	bool running_ = false;
+	bool failed_ = false;
+	bool saveRaw_ = false;
+	bool awbStats_ = false;
+	unsigned int rawCount_ = 0;
+	unsigned int outputCount_ = 0;
+	uint32_t lastSequence_ = UINT32_MAX;
+	std::vector<uint8_t> lastRaw_;
+	std::map<uint32_t, unsigned int> wanted_;
+	std::map<unsigned int, std::vector<uint8_t>> saved_;
+};
+
+} /* namespace libcamera */
