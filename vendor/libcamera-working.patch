diff --git i/src/apps/cam/lease_sink.cpp w/src/apps/cam/lease_sink.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..ceda1364ea09b3449ffdba4ba9b2ff62fa1019bc
--- /dev/null
+++ w/src/apps/cam/lease_sink.cpp
@@ -0,0 +1,194 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "lease_sink.h"
+
+#include <algorithm>
+#include <cerrno>
+#include <cstring>
+#include <iomanip>
+#include <iostream>
+#include <sstream>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+#include <libcamera/camera.h>
+#include <libcamera/control_ids.h>
+#include <libcamera/formats.h>
+#include <libcamera/framebuffer.h>
+#include <libcamera/request.h>
+
+#include "../common/event_loop.h"
+
+using namespace libcamera;
+
+LeaseSink::LeaseSink(const std::string &path) : path_(path) {}
+LeaseSink::~LeaseSink() { stop(); }
+
+int LeaseSink::configure(const CameraConfiguration &config)
+{
+	if (config.size() != 1 || config.at(0).size != Size(3840, 2160) ||
+	    config.at(0).pixelFormat != formats::NV12 || config.at(0).stride != 3840 ||
+	    config.at(0).bufferCount < 4 || config.at(0).bufferCount > 16)
+		return -EINVAL;
+	return 0;
+}
+
+void LeaseSink::mapBuffer(FrameBuffer *buffer) { buffers_.push_back(buffer); }
+
+bool LeaseSink::send(const std::string &text, const std::vector<int> &fds)
+{
+	if (text.size() > 8192 || fds.size() > 2 || failed_)
+		return false;
+	iovec iov{ const_cast<char *>(text.data()), text.size() };
+	alignas(cmsghdr) char control[CMSG_SPACE(2 * sizeof(int))]{};
+	msghdr msg{};
+	msg.msg_iov = &iov;
+	msg.msg_iovlen = 1;
+	if (!fds.empty()) {
+		msg.msg_control = control;
+		msg.msg_controllen = CMSG_SPACE(fds.size() * sizeof(int));
+		cmsghdr *cmsg = CMSG_FIRSTHDR(&msg);
+		cmsg->cmsg_level = SOL_SOCKET;
+		cmsg->cmsg_type = SCM_RIGHTS;
+		cmsg->cmsg_len = CMSG_LEN(fds.size() * sizeof(int));
+		memcpy(CMSG_DATA(cmsg), fds.data(), fds.size() * sizeof(int));
+	}
+	ssize_t n;
+	do { n = sendmsg(fd_, &msg, MSG_NOSIGNAL | MSG_DONTWAIT); } while (n < 0 && errno == EINTR);
+	if (n != static_cast<ssize_t>(text.size())) {
+		fail("packet send failed (no buffer may be reused)");
+		return false;
+	}
+	return true;
+}
+
+void LeaseSink::fail(const char *reason)
+{
+	failed_ = true;
+	std::cerr << "LEASE_ERROR: " << reason << std::endl;
+	EventLoop::instance()->exit(-EIO);
+}
+
+int LeaseSink::start()
+{
+	if (buffers_.size() < 4 || buffers_.size() > 16)
+		return -EINVAL;
+	sockaddr_un addr{};
+	addr.sun_family = AF_UNIX;
+	if (path_.size() >= sizeof(addr.sun_path))
+		return -ENAMETOOLONG;
+	memcpy(addr.sun_path, path_.c_str(), path_.size() + 1);
+	fd_ = socket(AF_UNIX, SOCK_SEQPACKET | SOCK_CLOEXEC, 0);
+	if (fd_ < 0)
+		return -errno;
+	if (connect(fd_, reinterpret_cast<sockaddr *>(&addr), sizeof(addr)))
+		return -errno;
+	for (unsigned int id = 0; id < buffers_.size(); ++id) {
+		const auto &planes = buffers_[id]->planes();
+		if (planes.size() != 2)
+			return -EINVAL;
+		std::ostringstream packet;
+		packet << "{\"type\":\"buffer\",\"id\":" << id << ",\"planes\":[";
+		std::vector<int> fds;
+		for (unsigned int i = 0; i < planes.size(); ++i) {
+			if (i) packet << ',';
+			packet << "{\"offset\":" << planes[i].offset
+			       << ",\"length\":" << planes[i].length << '}';
+			fds.push_back(planes[i].fd.get());
+		}
+		packet << "]}";
+		if (!send(packet.str(), fds)) return -EIO;
+	}
+	if (!send("{\"type\":\"start\",\"version\":1,\"width\":3840,\"height\":2160,\"stride\":3840,\"buffers\":" +
+		  std::to_string(buffers_.size()) + "}")) return -EIO;
+	EventLoop::instance()->addFdEvent(fd_, EventLoop::Read, [this]() { receive(); });
+	EventLoop::instance()->addTimerEvent(std::chrono::milliseconds(200), [this]() {
+		for (const auto &[id, lease] : leases_) {
+			if (std::chrono::steady_clock::now() - lease.since > std::chrono::seconds(3)) {
+				fail("unreleased capture buffer exceeded three seconds");
+				return;
+			}
+		}
+	});
+	return 0;
+}
+
+bool LeaseSink::processRequest(Request *request)
+{
+	if (failed_) return false;
+	FrameBuffer *buffer = request->buffers().begin()->second;
+	auto it = std::find(buffers_.begin(), buffers_.end(), buffer);
+	if (it == buffers_.end()) { fail("unregistered buffer"); return false; }
+	unsigned int id = it - buffers_.begin();
+	const auto &meta = buffer->metadata();
+	if (leases_.count(id) || meta.status != FrameMetadata::FrameSuccess ||
+	    meta.planes().size() != 2 || meta.planes()[0].bytesused != 3840 * 2160 ||
+	    meta.planes()[1].bytesused != 3840 * 1080) {
+		fail("invalid or already leased frame");
+		return false;
+	}
+	std::ostringstream packet;
+	packet << "{\"type\":\"frame\",\"id\":" << id << ",\"sequence\":" << meta.sequence
+	       << ",\"timestamp_ns\":" << meta.timestamp << ",\"metadata\":{";
+	bool first = true;
+	/* These controls have numeric/bool/array representations with no control
+	 * characters. Match cam's exact toString formatting for existing audits. */
+	for (const ControlId *key : std::initializer_list<const ControlId *>{ &controls::AeEnable, &controls::AwbEnable,
+		&controls::ExposureTime, &controls::AnalogueGain, &controls::DigitalGain,
+		&controls::ColourGains, &controls::SensorBlackLevels }) {
+		if (!request->metadata().contains(key->id())) continue;
+		if (!first) packet << ',';
+		first = false;
+		packet << std::quoted(key->name()) << ':'
+		       << std::quoted(request->metadata().get(key->id()).toString());
+	}
+	packet << "}}";
+	leases_.emplace(id, Lease{ request, meta.sequence, std::chrono::steady_clock::now() });
+	maxPending_ = std::max(maxPending_, leases_.size());
+	if (send(packet.str())) ++sent_;
+	return false; /* CameraSession must not requeue until receive() ACKs it. */
+}
+
+void LeaseSink::receive()
+{
+	for (;;) {
+		char packet[128];
+		ssize_t n = recv(fd_, packet, sizeof(packet), MSG_DONTWAIT | MSG_TRUNC);
+		if (n < 0 && errno == EINTR) continue;
+		if (n < 0 && (errno == EAGAIN || errno == EWOULDBLOCK)) return;
+		if (n <= 0 || n >= static_cast<ssize_t>(sizeof(packet))) {
+			fail("lease peer disconnected or invalid packet"); return;
+		}
+		std::istringstream in(std::string(packet, n));
+		std::string magic, extra;
+		unsigned int id;
+		uint64_t seq;
+		if (!(in >> magic >> id >> seq) || magic != "ACK1" || (in >> extra)) {
+			fail("malformed release"); return;
+		}
+		auto it = leases_.find(id);
+		if (it == leases_.end() || it->second.sequence != seq) {
+			fail("stale or unknown release"); return;
+		}
+		Request *request = it->second.request;
+		leases_.erase(it);
+		++released_;
+		requestProcessed.emit(request);
+	}
+}
+
+int LeaseSink::stop()
+{
+	if (fd_ < 0) return 0;
+	/* CameraSession stops hardware first. Outstanding leases are never
+	 * requeued here; descriptor references keep allocations alive in peer. */
+	std::ostringstream end;
+	end << "{\"type\":\"end\",\"sent\":" << sent_ << ",\"released\":" << released_
+	    << ",\"pending\":" << leases_.size() << ",\"max_pending\":" << maxPending_
+	    << ",\"failed\":" << (failed_ ? "true" : "false") << '}';
+	if (!failed_) send(end.str());
+	close(fd_);
+	fd_ = -1;
+	leases_.clear();
+	return failed_ ? -EIO : 0;
+}
