From: Brandon Williams <turbine.bmw@gmail.com>
Subject: [PATCH] gst: recover camera streams, negotiate output sizes and preserve timestamps

Based on PipeWire 1.6.9, commit 8fa27cabdc6c0c1350c69c026af5850ef0af1e26, src/gst.
MIT; original source notices retained.

diff --git a/gstpipewirepool.c b/gstpipewirepool.c
index 5e201d3151544547c59ecf10fff93259812ac1a7..b9dd2b2b0e4eeb221924d286e7cd9ff8a117eb39 100644
--- a/gstpipewirepool.c
+++ b/gstpipewirepool.c
@@ -253,6 +253,7 @@ acquire_buffer (GstBufferPool * pool, GstBuffer ** buffer,
   g_autoptr (GstPipeWireStream) s = g_weak_ref_get (&p->stream);
   GstPipeWirePoolData *data;
   struct pw_buffer *b;
+  gint64 deadline = 0;
 
   if (G_UNLIKELY (!s))
     return GST_FLOW_ERROR;
@@ -277,7 +278,45 @@ acquire_buffer (GstBufferPool * pool, GstBuffer ** buffer,
     }
 
     GST_WARNING_OBJECT (pool, "failed to dequeue buffer: %s", strerror(errno));
-    g_cond_wait (&p->cond, GST_OBJECT_GET_LOCK (pool));
+    if (GST_VIDEO_INFO_FPS_N (&p->video_info) > 0 &&
+        pw_stream_is_driving (s->pwstream)) {
+      /* A stopped consumer can exhaust the output pool. render() then
+       * cannot queue a buffer or trigger another graph cycle, including
+       * the cycle that returns buffers after the consumer resumes.
+       * The stream API requires drivers to retrigger unfinished cycles.
+       * Use three advertised video frame periods as the deadline. */
+      if (deadline == 0)
+        deadline = g_get_monotonic_time () + MAX ((gint64) 10000,
+            3 * (gint64) G_USEC_PER_SEC * GST_VIDEO_INFO_FPS_D (&p->video_info) /
+            GST_VIDEO_INFO_FPS_N (&p->video_info));
+      if (!g_cond_wait_until (&p->cond, GST_OBJECT_GET_LOCK (pool), deadline)) {
+        gboolean streaming;
+
+        deadline = 0;
+        /* Do not take the PipeWire loop lock while holding the pool lock.
+         * State changes and buffer removal can acquire them in reverse. */
+        GST_OBJECT_UNLOCK (pool);
+        pw_thread_loop_lock (s->core->loop);
+        streaming = s->pwstream != NULL &&
+            pw_stream_get_state (s->pwstream, NULL) == PW_STREAM_STATE_STREAMING;
+        if (streaming && pw_stream_is_driving (s->pwstream)) {
+          GST_DEBUG_OBJECT (pool, "retrigger starved video driver");
+          pw_stream_trigger_process (s->pwstream);
+        }
+        pw_thread_loop_unlock (s->core->loop);
+        if (!streaming) {
+          /* The consumer left while we waited (its link and buffers are
+           * gone). Do not hold this frame until the next link: it would go
+           * out first with a timestamp from before the gap, and live
+           * consumers then pace every later frame by that gap. */
+          GST_DEBUG_OBJECT (pool, "stream stopped streaming while starved; dropping frame");
+          return GST_PIPEWIRE_POOL_FLOW_DROP;
+        }
+        GST_OBJECT_LOCK (pool);
+      }
+    } else {
+      g_cond_wait (&p->cond, GST_OBJECT_GET_LOCK (pool));
+    }
   }
 
   data = b->user_data;
@@ -406,6 +445,36 @@ set_config (GstBufferPool * pool, GstStructure * config)
 }
 
 
+void gst_pipewire_pool_set_video_info (GstPipeWirePool *pool, const GstVideoInfo *info)
+{
+  GST_OBJECT_LOCK (pool);
+  pool->has_video = TRUE;
+  pool->video_info = *info;
+  pool->has_rawvideo = GST_VIDEO_FORMAT_INFO_IS_VALID_RAW (pool->video_info.finfo)
+#ifdef HAVE_GSTREAMER_DMA_DRM
+      && GST_VIDEO_FORMAT_INFO_FORMAT (pool->video_info.finfo) != GST_VIDEO_FORMAT_DMA_DRM
+#endif
+      ;
+#ifdef HAVE_GSTREAMER_SHM_ALLOCATOR
+  if (pool->has_rawvideo) {
+    gst_video_alignment_reset (&pool->video_align);
+    gst_video_info_align (&pool->video_info, &pool->video_align);
+  }
+#endif
+  GST_DEBUG_OBJECT (pool, "PipeWire buffers now %s %dx%d (%" G_GSIZE_FORMAT " bytes)",
+      gst_video_format_to_string (GST_VIDEO_INFO_FORMAT (&pool->video_info)),
+      GST_VIDEO_INFO_WIDTH (&pool->video_info), GST_VIDEO_INFO_HEIGHT (&pool->video_info),
+      pool->video_info.size);
+  GST_OBJECT_UNLOCK (pool);
+}
+
+void gst_pipewire_pool_get_video_info (GstPipeWirePool *pool, GstVideoInfo *info)
+{
+  GST_OBJECT_LOCK (pool);
+  *info = pool->video_info;
+  GST_OBJECT_UNLOCK (pool);
+}
+
 void gst_pipewire_pool_set_paused (GstPipeWirePool *pool, gboolean paused)
 {
   GST_DEBUG_OBJECT (pool, "pause: %u", paused);
@@ -435,8 +504,11 @@ release_buffer (GstBufferPool * pool, GstBuffer *buffer)
   GstPipeWirePool *p = GST_PIPEWIRE_POOL (pool);
   g_autoptr (GstPipeWireStream) s = g_weak_ref_get (&p->stream);
 
-  GST_OBJECT_LOCK (pool);
+  /* Format/buffer callbacks already hold the PipeWire loop before taking
+   * the pool lock. Keep the same order when a streaming thread returns a
+   * buffer during renegotiation. */
   pw_thread_loop_lock (s->core->loop);
+  GST_OBJECT_LOCK (pool);
 
   if (!data->queued && data->b != NULL)
   {
@@ -450,8 +522,8 @@ release_buffer (GstBufferPool * pool, GstBuffer *buffer)
     }
   }
 
-  pw_thread_loop_unlock (s->core->loop);
   GST_OBJECT_UNLOCK (pool);
+  pw_thread_loop_unlock (s->core->loop);
 }
 
 static gboolean
